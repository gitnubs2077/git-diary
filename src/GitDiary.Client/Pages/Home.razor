@page "/"
@using GitDiary.Client.Components
@using GitDiary.Client.Services
@using GitDiary.Client.Stores
@using GitDiary.Client.Infrastructure
@using GitDiary.Client.Models
@implements IDisposable

@if (_needsUnlock)
{
    <LockScreen Unlocked="OnUnlocked" />
}
else if (!SettingsStore.IsConfigured)
{
    <SetupWizard ConfigSaved="OnConfigSaved" />
}
else if (ShowSettings)
{
    <div class="settings-overlay"
         role="dialog"
         aria-modal="true"
         aria-labelledby="settings-title"
         tabindex="-1"
         @onclick="CloseSettings"
         @onkeydown="HandleSettingsOverlayKey">
        <div class="settings-container" @onclick:stopPropagation="true">
            <SetupWizard
                ExistingConfig="SettingsStore.Config"
                ConfigSaved="OnSettingsSaved"
                CancelClicked="CloseSettings"
                DisconnectRequested="OnDisconnect" />
        </div>
    </div>
}
else
{
    <div class="app-layout">
        <div class="app-sidebar">
            <Sidebar
                SelectedDate="@CurrentDate"
                OnEntrySelected="OnEntrySelected"
                OnSettingsClicked="OpenSettings"
                ShowLock="Vault.IsUnlocked"
                OnLockClicked="LockApp"
                OnGalleryClicked="OpenGallery"
                Section="_section"
                OnSectionChanged="OnSectionChanged"
                SelectedPath="@(DiaryStore.CurrentEntry?.Path)"
                OnDocSelected="OnDocSelected"
                OnNewDocClicked="OnNewDocClicked" />
        </div>
        <div class="app-resizer" @ref="_resizerRef" title="@L["home.resizerTooltip"]"></div>
        <div class="app-main">
            @if (DiaryStore.LoadError is not null)
            {
                <div class="load-error-banner @(DiaryStore.LoadErrorIsAuth ? "is-auth" : "")" role="alert">
                    <div class="load-error-text">
                        <strong>@(DiaryStore.LoadErrorIsAuth ? L["loadError.authTitle"] : L["loadError.genericTitle"])</strong>
                        <span>@(DiaryStore.LoadErrorIsAuth ? L["loadError.authBody"] : L["loadError.genericBody"])</span>
                    </div>
                    <div class="load-error-actions">
                        <button class="btn-reconnect" @onclick="OpenSettings">@L["loadError.reconnect"]</button>
                        <button class="btn-error-dismiss" @onclick="DiaryStore.ClearLoadError" aria-label="@L["loadError.dismiss"]">✕</button>
                    </div>
                </div>
            }
            <div class="app-toolbar">
                <SearchBox OnEntrySelected="OnEntrySelected" OnDocSelected="OnDocSelected" />
            </div>
            <div class="app-editor">
                <DiaryEditor />
            </div>
            <div class="app-statusbar">
                <StatusBar IsOffline="_isOffline" />
            </div>
        </div>
    </div>

    @if (_showGallery)
    {
        <ImageGallery OnClose="CloseGallery" />
    }

    @if (_showNewDocDialog)
    {
        <div class="modal-overlay" @onclick="CancelNewDoc">
            <div class="modal-dialog" role="dialog" aria-modal="true" @onclick:stopPropagation="true">
                <div class="modal-content">
                    <h3>@L["docs.newTitle"]</h3>
                    <input class="doc-title-input"
                           type="text"
                           placeholder="@L["docs.titlePlaceholder"]"
                           @bind="_newDocTitle"
                           @bind:event="oninput"
                           @onkeydown="HandleNewDocKey"
                           @ref="_newDocInputRef" />
                    <label class="doc-upload-link @(_newDocInFlight ? "disabled" : "")">
                        <span aria-hidden="true">📄</span> @L["docs.uploadMd"]
                        <InputFile class="doc-upload-input"
                                   accept=".md,.markdown,text/markdown,text/plain"
                                   OnChange="HandleMdUpload"
                                   disabled="@_newDocInFlight" />
                    </label>
                    <div class="modal-actions">
                        <button class="btn-cancel" @onclick="CancelNewDoc">@L["editor.cancel"]</button>
                        <button class="btn-doc-create" @onclick="ConfirmNewDoc" disabled="@_newDocInFlight">@L["docs.create"]</button>
                    </div>
                </div>
            </div>
        </div>
    }
}

@code {
    [Inject]
    private SettingsStore SettingsStore { get; set; } = default!;

    [Inject]
    private DiaryStore DiaryStore { get; set; } = default!;

    [Inject]
    private Services.GitHubApiClient GitHubApi { get; set; } = default!;

    [Inject]
    private Services.OnlineSyncCoordinator OnlineSync { get; set; } = default!;

    // Injected solely so a disconnect can erase locally-cached drafts, which hold
    // the diary text itself. Everything else goes through DiaryStore.
    [Inject]
    private Services.IndexedDbRepository Drafts { get; set; } = default!;

    [Inject]
    private LocalizationService L { get; set; } = default!;

    [Inject]
    private Services.VaultService Vault { get; set; } = default!;

    [Inject]
    private IJSRuntime JsRuntime { get; set; } = default!;

    private DateOnly? CurrentDate { get; set; }
    private bool ShowSettings { get; set; }
    private bool _showGallery;

    // Active top-level section (日记 vs 文档) + the "new document" dialog.
    private EntryKind _section = EntryKind.Diary;
    private bool _showNewDocDialog;
    private string _newDocTitle = "";
    private bool _newDocInFlight;
    private bool _focusNewDoc;
    private ElementReference _newDocInputRef;
    // True when a password vault exists but hasn't been unlocked this session. Gates
    // the entire app behind <LockScreen> — config isn't even decrypted until unlock.
    private bool _needsUnlock;
    private ElementReference _resizerRef;
    private bool _resizerAttached;
    // Keep the delegate as a field so Dispose can actually detach it.
    // Using inline `async () => …` on both += and -= creates two distinct
    // instances and Dispose silently no-ops, leaking a subscription per Home
    // instance against the singleton SettingsStore.
    private Action? _onSettingsChanged;

    // Global keyboard + beforeunload + reachability wiring is done via JS
    // interop, hence a DotNetObjectReference must survive the entire page
    // lifetime and be disposed in Dispose.
    private DotNetObjectReference<Home>? _selfRef;
    private bool _keysRegistered;
    private bool _beforeUnloadInstalled;
    private bool _netStatusSubscribed;
    private bool _isOffline;
    // Cache the last IsDirty value we pushed to JS so we don't spam the interop
    // on unrelated StateChanged notifications.
    private bool _lastPushedDirty;
    private Action? _onDiaryStateChanged;
    // Shadow copies of the load-error state Home last rendered. DiaryStore raises
    // StateChanged on every keystroke (IsDirty toggles), and re-rendering the whole
    // app shell that often is wasteful — so Home only re-renders when the banner's
    // own inputs actually change.
    private string? _lastRenderedLoadError;
    private bool _lastRenderedLoadErrorIsAuth;
    // Also shadow the open entry's path so Home re-renders when the *identity* of the
    // current entry changes (load / create / rename / delete) — that path feeds
    // <Sidebar SelectedPath>, and a rename fired from DiaryEditor would otherwise leave
    // Home's binding stale, dropping the doc's selection highlight. Path never changes
    // on a keystroke, so this keeps the per-keystroke re-render throttle intact.
    private string? _lastRenderedCurrentPath;

    protected override async Task OnInitializedAsync()
    {
        _onSettingsChanged = () => _ = InvokeAsync(StateHasChanged);
        SettingsStore.StateChanged += _onSettingsChanged;

        // DiaryStore signals every time IsDirty or the entry list changes.
        // We shadow-track IsDirty so JS can consult it synchronously during
        // beforeunload. Fire-and-forget to keep the callback non-blocking.
        _onDiaryStateChanged = () =>
        {
            _ = PushDirtyFlagAsync();

            // Re-render Home only when the load-error banner's inputs change — not on
            // every keystroke-driven StateChanged.
            if (_lastRenderedLoadError != DiaryStore.LoadError ||
                _lastRenderedLoadErrorIsAuth != DiaryStore.LoadErrorIsAuth ||
                _lastRenderedCurrentPath != DiaryStore.CurrentEntry?.Path)
            {
                _lastRenderedLoadError = DiaryStore.LoadError;
                _lastRenderedLoadErrorIsAuth = DiaryStore.LoadErrorIsAuth;
                _lastRenderedCurrentPath = DiaryStore.CurrentEntry?.Path;
                _ = InvokeAsync(StateHasChanged);
            }
        };
        DiaryStore.StateChanged += _onDiaryStateChanged;

        try
        {
            // A password vault takes precedence over everything: the config is stored
            // only as ciphertext, so we can't load it until the user unlocks. Render
            // <LockScreen> and stop here; OnUnlocked resumes the boot with the
            // decrypted config.
            if (await Vault.HasVaultAsync())
            {
                _needsUnlock = true;
                return;
            }

            // No vault → the legacy plaintext keys. They legitimately return `null`
            // on first run — hence `<string?>` and the explicit null checks below.
            var owner = await JsRuntime.InvokeAsync<string?>("localStorage.getItem", "gitdiary_owner");
            var repo = await JsRuntime.InvokeAsync<string?>("localStorage.getItem", "gitdiary_repo");
            var branch = await JsRuntime.InvokeAsync<string?>("localStorage.getItem", "gitdiary_branch");
            var token = await JsRuntime.InvokeAsync<string?>("localStorage.getItem", "gitdiary_token");

            if (!string.IsNullOrEmpty(owner) && !string.IsNullOrEmpty(repo) && !string.IsNullOrEmpty(token))
            {
                await ApplyConfigAndLoadAsync(new RepositoryConfig
                {
                    Owner = owner,
                    Repo = repo,
                    Branch = branch ?? "main",
                    Token = token
                });
            }
            // Otherwise: no config in localStorage yet → SetupWizard renders. That
            // is a normal first-run state, not an error, and needs no logging.
        }
        catch (Exception ex)
        {
            // Anything that actually throws here is unexpected: localStorage
            // unavailable, corrupted JSON somewhere in the config load, or a
            // GitHub round-trip failure. Log to console.error so users pasting
            // us a bug report at least have a stack trace, and continue — the
            // SetupWizard will render because SettingsStore.IsConfigured is
            // still false.
            Console.Error.WriteLine($"[GitDiary] Home.OnInitializedAsync failed: {ex.GetType().Name}: {ex.Message}");
            Console.Error.WriteLine(ex.StackTrace);
        }
    }

    // Applies a decrypted/loaded config to the API client and stores, then loads the
    // entry list and today's entry. Shared by the plaintext boot path and the
    // post-unlock path so the "configure the API client BEFORE flipping
    // SettingsStore.IsConfigured" ordering is enforced in exactly one place: the
    // moment IsConfigured flips, WASM synchronously re-renders and mounts <Sidebar>,
    // whose OnInitializedAsync dives straight into GitHubApiClient.
    private async Task ApplyConfigAndLoadAsync(RepositoryConfig config)
    {
        GitHubApi.SetConfig(config);
        GitHubApi.SetToken(config.Token);
        SettingsStore.SetConfig(config);

        try
        {
            var saved = await JsRuntime.InvokeAsync<string?>("localStorage.getItem", "gitdiary_section");
            _section = saved == "doc" ? EntryKind.Doc : EntryKind.Diary;
        }
        catch { /* localStorage unavailable — default to the diary section */ }

        await DiaryStore.RefreshEntriesAsync();
        if (_section == EntryKind.Doc) await DiaryStore.RefreshDocsAsync();
        // Boot always opens on today's diary entry; the section tab just governs which
        // list the sidebar shows. (Restoring the last-open doc would need its path
        // persisted too — deliberately out of scope.)
        await OnEntrySelected(PathHelper.GetToday());

        // Attach the browser `online` listener and try to flush any drafts that were
        // left Pending/Failed in a previous session.
        await OnlineSync.EnsureStartedAsync();
    }

    // The lock screen decrypted the vault and handed back the config: resume boot.
    private async Task OnUnlocked(RepositoryConfig config)
    {
        _needsUnlock = false;
        await ApplyConfigAndLoadAsync(config);
    }

    private async Task OnEntrySelected(DateOnly date)
    {
        CurrentDate = date;
        // Re-render now so the updated CurrentDate flows to <Sidebar SelectedDate>.
        // Matters for the keyboard-nav path: OnNewerDay/OnOlderDay are [JSInvokable]
        // and don't auto-render, so without this the sidebar highlight wouldn't follow
        // arrow-key navigation the way it does a click.
        StateHasChanged();
        await DiaryStore.LoadEntryAsync(date);
    }

    // --- Documents section ---------------------------------------------------

    private async Task OnSectionChanged(EntryKind kind)
    {
        if (_section == kind) return;
        _section = kind;
        try { await JsRuntime.InvokeVoidAsync("localStorage.setItem", "gitdiary_section", kind == EntryKind.Doc ? "doc" : "diary"); }
        catch { /* localStorage unavailable — section just won't persist */ }

        if (kind == EntryKind.Doc) await DiaryStore.RefreshDocsAsync();
        else await DiaryStore.RefreshEntriesAsync();
        StateHasChanged();
    }

    private async Task OnDocSelected(string path)
    {
        _section = EntryKind.Doc;
        StateHasChanged();
        await DiaryStore.LoadDocAsync(path);
    }

    private void OnNewDocClicked()
    {
        _newDocTitle = "";
        _newDocInFlight = false;
        _showNewDocDialog = true;
        _focusNewDoc = true;
    }

    private void CancelNewDoc() => _showNewDocDialog = false;

    private async Task ConfirmNewDoc()
    {
        if (_newDocInFlight) return;
        _newDocInFlight = true;
        try
        {
            _section = EntryKind.Doc;
            await DiaryStore.CreateDocAsync(_newDocTitle.Trim());
            _showNewDocDialog = false;
        }
        finally
        {
            _newDocInFlight = false;
        }
    }

    private async Task HandleNewDocKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await ConfirmNewDoc();
        else if (e.Key == "Escape") CancelNewDoc();
    }

    // Create a document from a picked local .md file: its text becomes the body and its
    // filename (or a title already typed in the dialog) becomes the doc title.
    private async Task HandleMdUpload(InputFileChangeEventArgs e)
    {
        if (_newDocInFlight) return;
        var file = e.File;
        if (file is null) return;

        _newDocInFlight = true;
        try
        {
            string content;
            // Cap at 5 MB — Markdown notes are tiny; this just guards against a stray
            // huge/binary file blowing up the read.
            using (var reader = new StreamReader(file.OpenReadStream(5 * 1024 * 1024)))
            {
                content = await reader.ReadToEndAsync();
            }

            var typed = _newDocTitle.Trim();
            var title = string.IsNullOrEmpty(typed)
                ? System.IO.Path.GetFileNameWithoutExtension(file.Name)
                : typed;

            _section = EntryKind.Doc;
            await DiaryStore.CreateDocAsync(title, content);
            _showNewDocDialog = false;
        }
        catch (Exception ex)
        {
            // Oversized/unreadable file — abort but leave the dialog open to retry.
            Console.Error.WriteLine($"[GitDiary] Home.HandleMdUpload: {ex.GetType().Name}: {ex.Message}");
        }
        finally
        {
            _newDocInFlight = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _selfRef ??= DotNetObjectReference.Create(this);

            // Global Ctrl/Cmd+S → SaveDraftAsync. Runs at window scope so it
            // works no matter where focus lives (sidebar, search box, preview).
            try
            {
                await JsRuntime.InvokeVoidAsync("gitdiaryKeys.register", _selfRef);
                _keysRegistered = true;
            }
            catch
            {
                // JS bridge unavailable — Ctrl+S falls back to the browser default.
            }

            // Confirm-before-unload guard. The JS side reads a cached flag we
            // update via PushDirtyFlagAsync whenever DiaryStore.StateChanged fires.
            try
            {
                await JsRuntime.InvokeVoidAsync("gitdiaryDirty.install");
                _beforeUnloadInstalled = true;
                await PushDirtyFlagAsync();
            }
            catch
            {
                // beforeunload guard unavailable — accept the loss of protection.
            }

            // Reachability watcher for the offline banner in the status bar.
            try
            {
                await JsRuntime.InvokeVoidAsync("gitdiaryNetStatus.subscribe", _selfRef);
                _netStatusSubscribed = true;
                var offline = await JsRuntime.InvokeAsync<bool>("gitdiaryNetStatus.isOffline");
                if (offline != _isOffline)
                {
                    _isOffline = offline;
                    StateHasChanged();
                }
            }
            catch
            {
                // No net-status API — leave the banner hidden.
            }
        }

        // The resizer element only exists when the main app-layout branch is
        // rendered (not the setup wizard / settings overlay). Re-attach whenever
        // that branch mounts — `attachResizer` is idempotent per element.
        var mounted = SettingsStore.IsConfigured && !ShowSettings;
        if (mounted && !_resizerAttached)
        {
            _resizerAttached = true;
            try
            {
                await JsRuntime.InvokeVoidAsync("gitdiarySidebar.attachResizer", _resizerRef);
            }
            catch
            {
                _resizerAttached = false;
            }
        }
        else if (!mounted && _resizerAttached)
        {
            _resizerAttached = false;
        }

        // Autofocus the title field the first render after the new-doc dialog opens.
        if (_focusNewDoc)
        {
            _focusNewDoc = false;
            try { await _newDocInputRef.FocusAsync(); }
            catch { /* element not in DOM yet — user can still click it */ }
        }
    }

    /// <summary>
    /// Global Ctrl/Cmd+S entry point invoked from JS. Flushes the current draft
    /// to IndexedDB when the editor has one, but never triggers a GitHub push —
    /// commits stay a deliberate user action.
    /// </summary>
    [JSInvokable]
    public async Task OnCtrlS()
    {
        if (DiaryStore.CurrentEntry is null) return;
        if (!DiaryStore.IsDirty) return;
        try
        {
            await DiaryStore.SaveDraftAsync();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[GitDiary] Home.OnCtrlS failed: {ex.GetType().Name}: {ex.Message}");
        }
    }

    // Ctrl/Cmd+Enter → commit to GitHub. Mirrors DiaryEditor's commit button (same
    // preconditions and flush-draft-first behaviour) so the shortcut and the button
    // stay consistent; both funnel into DiaryStore.CommitCurrentEntryAsync, which owns
    // the SyncState the editor renders.
    private bool _commitShortcutInFlight;

    [JSInvokable]
    public async Task OnCommitShortcut()
    {
        if (_commitShortcutInFlight) return;
        if (DiaryStore.CurrentEntry is null) return;
        if (DiaryStore.SyncState == SyncState.Saving) return;
        if (!DiaryStore.IsDirty && !DiaryStore.HasUncommittedDraft) return;

        _commitShortcutInFlight = true;
        try
        {
            if (DiaryStore.IsDirty)
            {
                await DiaryStore.SaveDraftAsync();
            }
            await DiaryStore.CommitCurrentEntryAsync();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[GitDiary] Home.OnCommitShortcut failed: {ex.GetType().Name}: {ex.Message}");
        }
        finally
        {
            _commitShortcutInFlight = false;
        }
    }

    // Arrow Up / Down → newer / older day. Up moves toward today (matches the
    // newest-first sidebar order); the future is off-limits, so Up stops at today.
    [JSInvokable]
    public Task OnNewerDay() => ShiftDayAsync(+1);

    [JSInvokable]
    public Task OnOlderDay() => ShiftDayAsync(-1);

    private async Task ShiftDayAsync(int direction)
    {
        // When a document is open, arrow keys walk the document list instead of days.
        if (DiaryStore.CurrentEntry?.Kind == EntryKind.Doc)
        {
            await ShiftDocAsync(direction);
            return;
        }

        if (CurrentDate is null) return;
        // Jump to the nearest day that actually has an entry, skipping empty days.
        var target = EntryNavigation.FindAdjacent(
            DiaryStore.Entries.Select(e => e.Date), CurrentDate.Value, direction);
        if (target is null) return;
        await OnEntrySelected(target.Value);
    }

    // Docs are ordered newest-first in the list. "Newer" (direction +1) moves up the
    // list toward index 0; "older" (-1) moves down. Stops at either end.
    private async Task ShiftDocAsync(int direction)
    {
        var docs = DiaryStore.Docs;
        if (docs.Count == 0) return;

        var currentPath = DiaryStore.CurrentEntry?.Path;
        var idx = docs.FindIndex(d => d.Path == currentPath);
        if (idx < 0) return;

        var targetIdx = idx - direction;
        if (targetIdx < 0 || targetIdx >= docs.Count) return;
        await OnDocSelected(docs[targetIdx].Path);
    }

    // Ctrl+L, or the sidebar lock button → return to the lock screen. Only meaningful
    // when a password vault is active. Flush unsaved edits into the (still-encrypted)
    // draft cache FIRST, then drop the key and clear in-memory config so nothing
    // sensitive lingers while locked. OnUnlocked re-applies everything.
    [JSInvokable]
    public Task OnLockShortcut() => LockApp();

    private async Task LockApp()
    {
        if (!Vault.IsUnlocked) return;

        try
        {
            if (DiaryStore.IsDirty)
            {
                await DiaryStore.SaveDraftAsync();
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[GitDiary] LockApp: failed to flush draft before locking: {ex.GetType().Name}: {ex.Message}");
        }

        await Vault.LockAsync();
        GitHubApi.ClearConfig();
        SettingsStore.ClearConfig();
        DiaryStore.Reset();

        ShowSettings = false;
        _needsUnlock = true;
        StateHasChanged();
    }

    /// <summary>Invoked from JS when the browser reports it has come back online.</summary>
    [JSInvokable]
    public Task OnNetOnline()
    {
        if (!_isOffline) return Task.CompletedTask;
        _isOffline = false;
        return InvokeAsync(StateHasChanged);
    }

    /// <summary>Invoked from JS when the browser reports it has lost network access.</summary>
    [JSInvokable]
    public Task OnNetOffline()
    {
        if (_isOffline) return Task.CompletedTask;
        _isOffline = true;
        return InvokeAsync(StateHasChanged);
    }

    private async Task PushDirtyFlagAsync()
    {
        if (!_beforeUnloadInstalled) return;
        var dirty = DiaryStore.IsDirty;
        if (dirty == _lastPushedDirty) return;
        _lastPushedDirty = dirty;
        try
        {
            await JsRuntime.InvokeVoidAsync("gitdiaryDirty.set", dirty);
        }
        catch
        {
            // Best-effort — a missed push just means the guard won't trigger.
        }
    }

    private void OpenSettings()
    {
        ShowSettings = true;
    }

    private void CloseSettings()
    {
        ShowSettings = false;
    }

    private void OpenGallery()
    {
        _showGallery = true;
    }

    private void CloseGallery()
    {
        _showGallery = false;
    }

    private void HandleSettingsOverlayKey(KeyboardEventArgs e)
    {
        // Esc dismisses the settings overlay — the SetupWizard inside handles
        // its own Esc too, but we listen here as a safety net in case focus
        // has escaped into the overlay backdrop.
        if (e.Key == "Escape")
        {
            CloseSettings();
        }
    }

    private async Task OnConfigSaved()
    {
        await PersistConfigAsync();
        StateHasChanged();
        var today = PathHelper.GetToday();
        await DiaryStore.RefreshEntriesAsync();
        await OnEntrySelected(today);
        await OnlineSync.EnsureStartedAsync();
    }

    private async Task OnSettingsSaved()
    {
        await PersistConfigAsync();
        ShowSettings = false;
        StateHasChanged();
        var today = PathHelper.GetToday();
        await DiaryStore.RefreshEntriesAsync();
        await OnEntrySelected(today);
        await OnlineSync.EnsureStartedAsync();
    }

    // Disconnect: erase every trace of the account from this browser.
    //
    // Until this existed there was no way to remove a PAT once entered —
    // SettingsStore.ClearConfig() had zero callers, and even it only nulled the
    // in-memory copy, so a reload resurrected the token straight out of
    // localStorage. On a shared or work machine the credential was, in practice,
    // permanent. Reconfiguring could overwrite it; nothing could erase it.
    //
    // Order matters. Wipe persistent storage FIRST: if an exception escapes
    // midway, a still-configured app with no stored token is a recoverable state,
    // whereas a logged-out app with the token still on disk is exactly the failure
    // this method exists to prevent.
    private async Task OnDisconnect()
    {
        try
        {
            foreach (var key in new[] { "gitdiary_token", "gitdiary_owner", "gitdiary_repo", "gitdiary_branch" })
            {
                await JsRuntime.InvokeVoidAsync("localStorage.removeItem", key);
            }

            // Drafts hold the diary text itself, not just the credential.
            await Drafts.ClearAllAsync();

            // Remove the encrypted vault too (if any) and drop the in-memory key, so a
            // disconnect leaves nothing — plaintext or ciphertext — behind.
            await Vault.DestroyAsync();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[GitDiary] OnDisconnect: failed to clear local storage: {ex.GetType().Name}: {ex.Message}");
        }

        GitHubApi.ClearConfig();
        SettingsStore.ClearConfig();
        DiaryStore.Reset();

        ShowSettings = false;
        StateHasChanged();
    }

    private async Task PersistConfigAsync()
    {
        if (SettingsStore.Config is not null)
        {
            if (Vault.IsUnlocked)
            {
                // A vault is active: keep the config as ciphertext (same password), never
                // write the plaintext keys back.
                await Vault.ReEncryptConfigAsync(SettingsStore.Config);
            }
            else
            {
                await JsRuntime.InvokeVoidAsync("localStorage.setItem", "gitdiary_owner", SettingsStore.Config.Owner);
                await JsRuntime.InvokeVoidAsync("localStorage.setItem", "gitdiary_repo", SettingsStore.Config.Repo);
                await JsRuntime.InvokeVoidAsync("localStorage.setItem", "gitdiary_branch", SettingsStore.Config.Branch);
                await JsRuntime.InvokeVoidAsync("localStorage.setItem", "gitdiary_token", SettingsStore.Config.Token);
            }

            GitHubApi.SetConfig(SettingsStore.Config);
            GitHubApi.SetToken(SettingsStore.Config.Token);
        }
    }

    public void Dispose()
    {
        if (_onSettingsChanged is not null)
        {
            SettingsStore.StateChanged -= _onSettingsChanged;
            _onSettingsChanged = null;
        }
        if (_onDiaryStateChanged is not null)
        {
            DiaryStore.StateChanged -= _onDiaryStateChanged;
            _onDiaryStateChanged = null;
        }

        // Unregister JS-side listeners so their captured DotNetObjectReference
        // isn't invoked after Dispose. Wrapped in try/catch because we may be
        // tearing down inside a page unload where the JS side has already gone.
        if (_keysRegistered)
        {
            try { _ = JsRuntime.InvokeVoidAsync("gitdiaryKeys.unregister"); } catch { }
            _keysRegistered = false;
        }
        if (_netStatusSubscribed)
        {
            try { _ = JsRuntime.InvokeVoidAsync("gitdiaryNetStatus.unsubscribe"); } catch { }
            _netStatusSubscribed = false;
        }

        _selfRef?.Dispose();
        _selfRef = null;
    }
}
