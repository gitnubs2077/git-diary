@using GitDiary.Client.Services
@implements IDisposable

<div class="search-box">
    <div class="search-input-wrapper">
        <input
            type="text"
            placeholder="@L["search.placeholder"]"
            @bind="Keyword"
            @bind:event="oninput"
            @onkeyup="HandleKeyUp"
            @ref="SearchInput" />
        <button class="btn-search" @onclick="DoSearch" disabled="@string.IsNullOrWhiteSpace(Keyword)">
            🔍
        </button>
    </div>

    @if (SearchResults is not null && SearchResults.Any())
    {
        <div class="search-results" role="listbox" aria-label="@L["search.placeholder"]">
            <div class="search-results-header">
                @L.Format("search.found", SearchResults.Count)
                <button class="btn-close-results" @onclick="ClearSearch" aria-label="@L["editor.cancel"]">✕</button>
            </div>
            @foreach (var result in SearchResults)
            {
                <div class="search-result-item"
                     role="option"
                     tabindex="0"
                     aria-selected="false"
                     @onclick="() => SelectResult(result)"
                     @onkeydown="e => OnResultKey(e, result)">
                    <div class="result-date">
                        @if (result.Kind == Models.EntryKind.Doc)
                        {
                            <span class="result-kind" aria-hidden="true">📄</span>@result.Title
                        }
                        else
                        {
                            <span class="result-kind" aria-hidden="true">📔</span>@result.Date.ToString("yyyy-MM-dd")
                        }
                    </div>
                    <div class="result-preview">@GetPreview(result.Content)</div>
                </div>
            }
        </div>
    }
</div>

@code {
    [Inject]
    private SearchService SearchService { get; set; } = default!;

    [Inject]
    private Stores.DiaryStore DiaryStore { get; set; } = default!;

    [Inject]
    private LocalizationService L { get; set; } = default!;

    [Parameter]
    public EventCallback<DateOnly> OnEntrySelected { get; set; }

    [Parameter]
    public EventCallback<string> OnDocSelected { get; set; }

    private string Keyword { get; set; } = "";
    private List<Models.DiaryEntry>? SearchResults { get; set; }
    private ElementReference SearchInput;

    protected override void OnInitialized()
    {
        L.StateChanged += HandleLocalizationChanged;
    }

    private async void HandleLocalizationChanged()
    {
        // async void: never let an exception escape to the sync context.
        try
        {
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[GitDiary] SearchBox.HandleLocalizationChanged: {ex.GetType().Name}: {ex.Message}");
        }
    }

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await DoSearch();
        }
        else if (e.Key == "Escape")
        {
            ClearSearch();
        }
        else if (string.IsNullOrWhiteSpace(Keyword))
        {
            SearchResults = null;
        }
    }

    private async Task DoSearch()
    {
        if (string.IsNullOrWhiteSpace(Keyword))
        {
            SearchResults = null;
            return;
        }

        await DiaryStore.BuildSearchIndexAsync();
        SearchResults = SearchService.Search(Keyword);
        await InvokeAsync(StateHasChanged);
    }

    private async Task SelectResult(Models.DiaryEntry result)
    {
        if (result.Kind == Models.EntryKind.Doc)
        {
            // Home.OnDocSelected owns the load (LoadDocAsync) and section switch.
            await OnDocSelected.InvokeAsync(result.Path);
        }
        else
        {
            await DiaryStore.LoadEntryAsync(result.Date);
            await OnEntrySelected.InvokeAsync(result.Date);
        }
        ClearSearch();
    }

    // Enter / Space on a role="option" row selects the entry. Esc collapses
    // the results panel back to the input.
    private Task OnResultKey(KeyboardEventArgs e, Models.DiaryEntry result)
    {
        if (e.Key == "Enter" || e.Key == " " || e.Key == "Spacebar")
        {
            return SelectResult(result);
        }
        if (e.Key == "Escape")
        {
            ClearSearch();
        }
        return Task.CompletedTask;
    }

    private void ClearSearch()
    {
        Keyword = "";
        SearchResults = null;
    }

    private string GetPreview(string content)
    {
        if (string.IsNullOrEmpty(content))
            return "";

        // Remove markdown headers and take first 100 chars
        var plain = System.Text.RegularExpressions.Regex.Replace(content, @"^#+\s*", "", System.Text.RegularExpressions.RegexOptions.Multiline);
        return plain.Length > 100 ? plain[..100] + "..." : plain;
    }

    public void Dispose()
    {
        L.StateChanged -= HandleLocalizationChanged;
    }
}
