@using GitDiary.Client.Infrastructure
@using GitDiary.Client.Models
@using GitDiary.Client.Stores
@using GitDiary.Client.Services
@using System.Text.Json
@inject IJSRuntime JsRuntime
@implements IDisposable

<div class="sidebar">
    <div class="sidebar-header">
        <div class="sidebar-brand">
            <img src="favicon.svg" alt="" class="sidebar-logo" aria-hidden="true" />
            <h3>@L["sidebar.title"]</h3>
        </div>
        <div class="sidebar-header-actions">
            <div class="theme-picker">
                <button class="btn-icon"
                        @onclick="ToggleThemeMenu"
                        title="@ThemeTooltip"
                        aria-haspopup="menu"
                        aria-expanded="@_themeMenuOpen.ToString().ToLowerInvariant()">
                    @ThemeSvc.CurrentTheme.DisplayIcon()
                </button>
                @if (_themeMenuOpen)
                {
                    @* Transparent full-viewport backdrop: catches any click that
                       lands outside the menu and closes it. Sits below the menu
                       (z-index) but above the rest of the app. *@
                    <div class="theme-menu-backdrop" @onclick="CloseThemeMenu"></div>
                    <div class="theme-menu" role="menu">
                        <div class="theme-menu-section" role="group" aria-label="@L["skin.heading"]">
                            <div class="theme-menu-heading">@L["skin.heading"]</div>
                            @foreach (var s in SkinExtensions.All)
                            {
                                var isCurrent = s == ThemeSvc.CurrentSkin;
                                <button type="button"
                                        class="theme-menu-item @(isCurrent ? "selected" : "")"
                                        role="menuitemradio"
                                        aria-checked="@isCurrent.ToString().ToLowerInvariant()"
                                        @onclick="() => PickSkin(s)">
                                    <span class="theme-menu-icon" aria-hidden="true">@s.DisplayIcon()</span>
                                    <span class="theme-menu-label">@L[s.LabelKey()]</span>
                                </button>
                            }
                        </div>
                        <div class="theme-menu-divider" role="separator"></div>
                        <div class="theme-menu-section" role="group" aria-label="@L["theme.modeHeading"]">
                            <div class="theme-menu-heading">@L["theme.modeHeading"]</div>
                            @foreach (var t in ThemeExtensions.All)
                            {
                                var isCurrent = t == ThemeSvc.CurrentTheme;
                                <button type="button"
                                        class="theme-menu-item @(isCurrent ? "selected" : "")"
                                        role="menuitemradio"
                                        aria-checked="@isCurrent.ToString().ToLowerInvariant()"
                                        @onclick="() => PickMode(t)">
                                    <span class="theme-menu-icon" aria-hidden="true">@t.DisplayIcon()</span>
                                    <span class="theme-menu-label">@L[t.LabelKey()]</span>
                                </button>
                            }
                        </div>
                    </div>
                }
            </div>
            <button class="btn-icon" @onclick="Gallery" title="@L["sidebar.gallery"]" aria-label="@L["sidebar.gallery"]">🏞️</button>
            @if (ShowLock)
            {
                <button class="btn-icon" @onclick="Lock" title="@L["sidebar.lock"]" aria-label="@L["sidebar.lock"]">🔒</button>
            }
            <button class="btn-icon" @onclick="OpenSettings" title="@L["sidebar.settings"]">⚙️</button>
            @if (Section == EntryKind.Doc)
            {
                <button class="btn-new" @onclick="NewDoc">@L["sidebar.newDoc"]</button>
            }
            else
            {
                <button class="btn-new" @onclick="CreateTodayEntry">@L["sidebar.newToday"]</button>
            }
        </div>
    </div>

    <div class="section-tabs" role="tablist" aria-label="@L["section.aria"]">
        <button type="button" class="section-tab @(Section == EntryKind.Diary ? "active" : "")"
                role="tab" aria-selected="@(Section == EntryKind.Diary ? "true" : "false")"
                @onclick="() => SwitchSection(EntryKind.Diary)">📔 @L["section.diary"]</button>
        <button type="button" class="section-tab @(Section == EntryKind.Doc ? "active" : "")"
                role="tab" aria-selected="@(Section == EntryKind.Doc ? "true" : "false")"
                @onclick="() => SwitchSection(EntryKind.Doc)">📄 @L["section.docs"]</button>
    </div>

    <div class="sidebar-list">
        @if (Section == EntryKind.Diary)
        {
        @if (GroupedEntries is not null)
        {
            @foreach (var yearGroup in GroupedEntries)
            {
                <div class="year-group">
                    <div class="year-header"
                         role="button"
                         tabindex="0"
                         aria-expanded="@ExpandedYears.Contains(yearGroup.Year).ToString().ToLowerInvariant()"
                         @onclick="() => ToggleYear(yearGroup.Year)"
                         @onkeydown="e => OnActivateKey(e, () => ToggleYear(yearGroup.Year))">
                        <span class="toggle-icon">@(ExpandedYears.Contains(yearGroup.Year) ? "▼" : "▶")</span>
                        <span class="year-label">@yearGroup.Year</span>
                    </div>

                    @if (ExpandedYears.Contains(yearGroup.Year))
                    {
                        @foreach (var monthGroup in yearGroup.Months)
                        {
                            <div class="month-group">
                                <div class="month-header"
                                     role="button"
                                     tabindex="0"
                                     aria-expanded="@ExpandedMonths.Contains((monthGroup.Year, monthGroup.Month)).ToString().ToLowerInvariant()"
                                     @onclick="() => ToggleMonth(monthGroup.Year, monthGroup.Month)"
                                     @onkeydown="e => OnActivateKey(e, () => ToggleMonth(monthGroup.Year, monthGroup.Month))">
                                    <span class="toggle-icon">@(ExpandedMonths.Contains((monthGroup.Year, monthGroup.Month)) ? "▼" : "▶")</span>
                                    <span class="month-label">@monthGroup.Month.ToString("D2")</span>
                                </div>

                                @if (ExpandedMonths.Contains((monthGroup.Year, monthGroup.Month)))
                                {
                                    @foreach (var entry in monthGroup.Entries)
                                    {
                                        <div
                                            class="diary-entry-item @(IsSelected(entry.Date) ? "selected" : "") @(IsToday(entry.Date) ? "is-today" : "")"
                                            role="button"
                                            tabindex="0"
                                            aria-current="@(IsSelected(entry.Date) ? "true" : "false")"
                                            @onclick="() => SelectEntry(entry.Date)"
                                            @onkeydown="e => OnActivateKey(e, () => SelectEntry(entry.Date))">
                                            @if (IsLoadingEntry(entry.Date))
                                            {
                                                <span class="entry-spinner"
                                                      role="status"
                                                      aria-label="@L["sidebar.loading"]"
                                                      title="@L["sidebar.loading"]"></span>
                                            }
                                            @entry.Date.ToString("yyyy-MM-dd")
                                            @if (IsToday(entry.Date))
                                            {
                                                <span class="today-badge" aria-hidden="true">·</span>
                                            }
                                        </div>
                                    }
                                }
                            </div>
                        }
                    }
                </div>
            }
        }

        @if (GroupedEntries is null || !GroupedEntries.Any())
        {
            <div class="sidebar-empty">@L["sidebar.empty"]</div>
        }
        }
        else
        {
            @if (DiaryStore.Docs.Count > 0)
            {
                @foreach (var doc in DiaryStore.Docs)
                {
                    <div class="doc-item @(IsDocSelected(doc.Path) ? "selected" : "")"
                         role="button"
                         tabindex="0"
                         aria-current="@(IsDocSelected(doc.Path) ? "true" : "false")"
                         @onclick="() => SelectDoc(doc.Path)"
                         @onkeydown="e => OnActivateKey(e, () => SelectDoc(doc.Path))">
                        <div class="doc-title">@doc.Title</div>
                        <div class="doc-meta">
                            <span>@doc.CreatedAt.LocalDateTime.ToString("yyyy-MM-dd HH:mm")</span>
                            @if (string.IsNullOrEmpty(doc.Sha))
                            {
                                <span class="doc-uncommitted" title="@L["docs.uncommitted"]">•</span>
                            }
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="sidebar-empty">@L["docs.empty"]</div>
            }
        }
    </div>
</div>

@code {
    [Inject]
    private DiaryStore DiaryStore { get; set; } = default!;

    [Inject]
    private LocalizationService L { get; set; } = default!;

    [Inject]
    private ThemeService ThemeSvc { get; set; } = default!;

    [Inject]
    private SettingsStore SettingsStore { get; set; } = default!;

    [Parameter]
    public EventCallback<DateOnly> OnEntrySelected { get; set; }

    [Parameter]
    public DateOnly? SelectedDate { get; set; }

    [Parameter]
    public EventCallback OnSettingsClicked { get; set; }

    // Shown only when a password vault is active — locking is meaningless otherwise.
    [Parameter]
    public bool ShowLock { get; set; }

    [Parameter]
    public EventCallback OnLockClicked { get; set; }

    [Parameter]
    public EventCallback OnGalleryClicked { get; set; }

    // --- Documents section ---
    [Parameter]
    public EntryKind Section { get; set; } = EntryKind.Diary;

    [Parameter]
    public EventCallback<EntryKind> OnSectionChanged { get; set; }

    /// <summary>Path of the currently-open entry — used to highlight the selected doc.</summary>
    [Parameter]
    public string? SelectedPath { get; set; }

    [Parameter]
    public EventCallback<string> OnDocSelected { get; set; }

    [Parameter]
    public EventCallback OnNewDocClicked { get; set; }

    private HashSet<int> ExpandedYears { get; set; } = new();
    // Key on (year, month) — using just the month number would collide across years
    // (e.g. expanding July 2025 would also expand July 2024).
    private HashSet<(int Year, int Month)> ExpandedMonths { get; set; } = new();

    // Theme picker popover open state. Kept local — it's throwaway UI state and
    // doesn't need to survive re-mount.
    private bool _themeMenuOpen;

    // Grouped-entries cache. The tree computation isn't expensive per-call, but
    // it runs from GetGroupedEntries() which is invoked from the render body —
    // meaning every StateChanged (draft save, theme cycle, language switch,
    // etc.) re-groups the entire entry list. Fingerprinting by count + the
    // list reference sidesteps that unless the entry set actually changed.
    private List<YearGroup>? _cachedGroups;
    private object? _cachedGroupsSource;
    private int _cachedGroupsCount = -1;

    private List<YearGroup>? GroupedEntries => GetGroupedEntries();

    protected override async Task OnInitializedAsync()
    {
        // Belt-and-braces: Home is supposed to configure GitHubApiClient before
        // flipping SettingsStore.IsConfigured, but WASM's synchronous StateHasChanged
        // makes that ordering fragile. If we get here without config, just skip
        // the fetch — HandleStateChanged will refresh once config lands.
        if (SettingsStore.IsConfigured)
        {
            await DiaryStore.RefreshEntriesAsync();
        }
        DiaryStore.StateChanged += HandleStateChanged;
        L.StateChanged += HandleStateChanged;
        ThemeSvc.StateChanged += HandleStateChanged;

        await LoadExpandStateAsync();

        // Auto select today
        if (SelectedDate == null)
        {
            var today = PathHelper.GetToday();
            EnsureExpanded(today);
            await SelectEntry(today);
        }
    }

    // Fires whenever the parent re-renders with a (possibly) new SelectedDate — the
    // path arrow-key navigation takes (Home.CurrentDate → SelectedDate). Keep the
    // highlighted entry reachable: expand its year/month (a collapsed group doesn't
    // render its entries at all) and flag a scroll-into-view for after the render.
    private DateOnly? _lastSelectionShown;
    private bool _scrollSelectionPending;

    protected override void OnParametersSet()
    {
        if (SelectedDate is not null && SelectedDate != _lastSelectionShown)
        {
            _lastSelectionShown = SelectedDate;
            EnsureExpanded(SelectedDate.Value);
            _scrollSelectionPending = true;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_scrollSelectionPending)
        {
            _scrollSelectionPending = false;
            try
            {
                await JsRuntime.InvokeVoidAsync("gitdiarySidebar.scrollSelectedIntoView");
            }
            catch
            {
                // JS bridge unavailable or the element isn't in the DOM yet — harmless.
            }
        }
    }

    private const string ExpandStateKey = "gitdiary_sidebar_expand";

    private sealed class ExpandStateDto
    {
        public List<int> Years { get; set; } = new();
        public List<int[]> Months { get; set; } = new();
    }

    private async Task LoadExpandStateAsync()
    {
        try
        {
            var raw = await JsRuntime.InvokeAsync<string?>("localStorage.getItem", ExpandStateKey);
            if (string.IsNullOrWhiteSpace(raw)) return;
            var dto = JsonSerializer.Deserialize<ExpandStateDto>(raw);
            if (dto is null) return;
            ExpandedYears = new HashSet<int>(dto.Years);
            ExpandedMonths = new HashSet<(int Year, int Month)>(
                dto.Months.Where(m => m.Length == 2).Select(m => (m[0], m[1])));
        }
        catch
        {
            // Corrupted or unavailable — leave defaults.
        }
    }

    private async Task PersistExpandStateAsync()
    {
        try
        {
            var dto = new ExpandStateDto
            {
                Years = ExpandedYears.ToList(),
                Months = ExpandedMonths.Select(m => new[] { m.Year, m.Month }).ToList()
            };
            await JsRuntime.InvokeVoidAsync(
                "localStorage.setItem", ExpandStateKey, JsonSerializer.Serialize(dto));
        }
        catch
        {
            // Persistence best-effort.
        }
    }

    private void EnsureExpanded(DateOnly date)
    {
        ExpandedYears.Add(date.Year);
        ExpandedMonths.Add((date.Year, date.Month));
    }

    private async void HandleStateChanged()
    {
        // async void: never let an exception escape to the sync context.
        try
        {
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[GitDiary] Sidebar.HandleStateChanged: {ex.GetType().Name}: {ex.Message}");
        }
    }

    private async Task SelectEntry(DateOnly date)
    {
        SelectedDate = date;
        await DiaryStore.LoadEntryAsync(date);
        await OnEntrySelected.InvokeAsync(date);
    }

    private async Task CreateTodayEntry()
    {
        var today = PathHelper.GetToday();
        SelectedDate = today;
        await DiaryStore.LoadEntryAsync(today);
    }

    private async Task SwitchSection(EntryKind kind)
    {
        if (Section == kind) return;
        await OnSectionChanged.InvokeAsync(kind);
    }

    private async Task SelectDoc(string path) => await OnDocSelected.InvokeAsync(path);

    private async Task NewDoc() => await OnNewDocClicked.InvokeAsync();

    private bool IsDocSelected(string path) => SelectedPath == path;

    private async Task Lock()
    {
        await OnLockClicked.InvokeAsync();
    }

    private async Task OpenSettings()
    {
        await OnSettingsClicked.InvokeAsync();
    }

    private async Task Gallery()
    {
        await OnGalleryClicked.InvokeAsync();
    }

    // System → Light → Dark → Fluent → Windows XP → Mac. Kept as a fallback for
    // keyboard-only users; the picker below is the primary UI.
    private void ToggleThemeMenu() => _themeMenuOpen = !_themeMenuOpen;

    private void CloseThemeMenu() => _themeMenuOpen = false;

    private async Task PickMode(Theme mode)
    {
        _themeMenuOpen = false;
        if (ThemeSvc.CurrentTheme != mode)
        {
            await ThemeSvc.SetThemeAsync(mode);
        }
    }

    private async Task PickSkin(Skin skin)
    {
        _themeMenuOpen = false;
        if (ThemeSvc.CurrentSkin != skin)
        {
            await ThemeSvc.SetSkinAsync(skin);
        }
    }

    private string ThemeTooltip
    {
        get
        {
            var skinLabel = L[ThemeSvc.CurrentSkin.LabelKey()];
            var modeLabel = L[ThemeSvc.CurrentTheme.LabelKey()];
            return L.Format("sidebar.theme", skinLabel + " · " + modeLabel);
        }
    }

    private bool IsSelected(DateOnly date) => SelectedDate == date;

    private bool IsToday(DateOnly date) => date == PathHelper.GetToday();

    // Only the currently-selected entry can be loading — DiaryStore serves one
    // entry at a time — so we key the spinner off both flags. SelectedDate is
    // updated synchronously before LoadEntryAsync awaits, so the spinner
    // appears on the target row from the first render.
    private bool IsLoadingEntry(DateOnly date) =>
        DiaryStore.IsLoading && SelectedDate == date;

    // Turns Enter / Space presses on role="button" divs into activations. Space
    // must be intercepted synchronously so the browser's default page-scroll
    // doesn't fire; Enter is a no-op default anyway but handled here for
    // consistency.
    private static Task OnActivateKey(KeyboardEventArgs e, Action action)
    {
        if (e.Key == "Enter" || e.Key == " " || e.Key == "Spacebar")
        {
            action();
        }
        return Task.CompletedTask;
    }

    private static Task OnActivateKey(KeyboardEventArgs e, Func<Task> action)
    {
        if (e.Key == "Enter" || e.Key == " " || e.Key == "Spacebar")
        {
            return action();
        }
        return Task.CompletedTask;
    }

    private async Task ToggleYear(int year)
    {
        if (ExpandedYears.Contains(year))
            ExpandedYears.Remove(year);
        else
            ExpandedYears.Add(year);
        await PersistExpandStateAsync();
    }

    private async Task ToggleMonth(int year, int month)
    {
        var key = (year, month);
        if (ExpandedMonths.Contains(key))
            ExpandedMonths.Remove(key);
        else
            ExpandedMonths.Add(key);
        await PersistExpandStateAsync();
    }

    private List<YearGroup>? GetGroupedEntries()
    {
        var entries = DiaryStore.Entries;
        if (entries == null || entries.Count == 0)
            return null;

        // Skip the group-and-sort chain when the entry set hasn't changed. We
        // compare both the list reference AND its count: DiaryStore reuses the
        // same List<> across refreshes but mutates it in-place, so reference
        // equality alone would produce a stale cache.
        if (ReferenceEquals(_cachedGroupsSource, entries)
            && _cachedGroupsCount == entries.Count
            && _cachedGroups is not null)
        {
            return _cachedGroups;
        }

        var grouped = entries
            .GroupBy(e => e.Date.Year)
            .Select(yearGroup => new YearGroup
            {
                Year = yearGroup.Key,
                Months = yearGroup
                    .GroupBy(e => e.Date.Month)
                    .Select(monthGroup => new MonthGroup
                    {
                        Year = yearGroup.Key,
                        Month = monthGroup.Key,
                        Entries = monthGroup.OrderByDescending(e => e.Date).ToList()
                    })
                    .OrderByDescending(m => m.Month)
                    .ToList()
            })
            .OrderByDescending(y => y.Year)
            .ToList();

        _cachedGroups = grouped;
        _cachedGroupsSource = entries;
        _cachedGroupsCount = entries.Count;
        return grouped;
    }

    public void Dispose()
    {
        DiaryStore.StateChanged -= HandleStateChanged;
        L.StateChanged -= HandleStateChanged;
        ThemeSvc.StateChanged -= HandleStateChanged;
    }

    private class YearGroup
    {
        public int Year { get; set; }
        public List<MonthGroup> Months { get; set; } = new();
    }

    private class MonthGroup
    {
        public int Year { get; set; }
        public int Month { get; set; }
        public List<DiaryEntryInfo> Entries { get; set; } = new();
    }
}
