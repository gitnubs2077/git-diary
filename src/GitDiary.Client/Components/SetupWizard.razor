@using GitDiary.Client.Models
@using GitDiary.Client.Stores
@using GitDiary.Client.Services
@using System.Text.RegularExpressions
@implements IDisposable

<div class="setup-wizard" @onkeydown="HandleWizardKey">
    <div class="setup-card">
        <div class="setup-header">
            <h1 id="settings-title">📔 GitDiary</h1>
            <p class="setup-subtitle">@EffectiveSubtitle</p>
        </div>

        <div class="setup-form">
            <div class="form-group">
                <label for="language">@L["setup.language"]</label>
                <select id="language" value="@L.CurrentLanguage.Code()" @onchange="OnLanguageChanged">
                    @foreach (var lang in L.AvailableLanguages)
                    {
                        <option value="@lang.Code()">@lang.DisplayName()</option>
                    }
                </select>
            </div>

            <div class="form-group">
                <label for="owner">@L["setup.labelOwner"]</label>
                <input
                    id="owner"
                    type="text"
                    placeholder="@L["setup.placeholderOwner"]"
                    value="@Owner"
                    @oninput="OnOwnerInput"
                    @ref="_ownerRef" />
            </div>

            <div class="form-group">
                <label for="repo">@L["setup.labelRepo"]</label>
                <input
                    id="repo"
                    type="text"
                    placeholder="@L["setup.placeholderRepo"]"
                    value="@Repo"
                    @oninput="OnRepoInput" />
                @if (RepoUrl is not null)
                {
                    <small class="form-hint">
                        <a href="@RepoUrl" target="_blank" rel="noopener noreferrer">@L["setup.viewRepo"]</a>
                    </small>
                }
            </div>

            <div class="form-group">
                <label for="branch">@L["setup.labelBranch"]</label>
                <input
                    id="branch"
                    type="text"
                    placeholder="@L["setup.placeholderBranch"]"
                    value="@Branch"
                    @oninput="OnBranchInput" />
            </div>

            <div class="form-group">
                <label for="token">@L["setup.labelToken"]</label>
                <input
                    id="token"
                    type="password"
                    placeholder="@L["setup.placeholderToken"]"
                    value="@Token"
                    @oninput="OnTokenInput" />
                <small class="form-hint">
                    @L["setup.tokenHint"]
                    <a href="https://github.com/settings/tokens?type=beta" target="_blank">@L["setup.createToken"]</a>
                </small>
            </div>

            <div class="form-group form-lock">
                @if (!_hasVault)
                {
                    <label for="lockpw">@L["setup.lockLabel"]</label>
                    <input
                        id="lockpw"
                        type="password"
                        autocomplete="new-password"
                        placeholder="@L["setup.lockPlaceholder"]"
                        value="@LockPassword"
                        @oninput="OnLockPasswordInput" />
                    @if (!string.IsNullOrEmpty(LockPassword))
                    {
                        <input
                            type="password"
                            autocomplete="new-password"
                            placeholder="@L["setup.lockConfirm"]"
                            value="@LockPasswordConfirm"
                            @oninput="OnLockConfirmInput" />
                    }
                    <small class="form-hint">@L["setup.lockHint"]</small>
                }
                else
                {
                    <label>@L["setup.lockChangeLabel"]</label>
                    <input
                        type="password"
                        autocomplete="new-password"
                        placeholder="@L["setup.lockNewPlaceholder"]"
                        value="@LockPassword"
                        @oninput="OnLockPasswordInput" />
                    <input
                        type="password"
                        autocomplete="new-password"
                        placeholder="@L["setup.lockConfirm"]"
                        value="@LockPasswordConfirm"
                        @oninput="OnLockConfirmInput" />
                    <div class="lock-actions">
                        <button class="btn-secondary"
                                @onclick="ChangePasswordAsync"
                                disabled="@(string.IsNullOrEmpty(LockPassword) || _pwInFlight)">
                            @L["setup.lockChange"]
                        </button>
                        <button class="btn-remove-lock" @onclick="RemovePasswordAsync" disabled="@_pwInFlight">
                            @L["setup.lockRemove"]
                        </button>
                    </div>
                    <small class="form-hint">@L["setup.lockChangeHint"]</small>
                }
                @if (!string.IsNullOrEmpty(_pwMessage))
                {
                    <div class="lock-message">@_pwMessage</div>
                }
            </div>

            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <div class="form-error">❌ @ErrorMessage</div>
            }

            <div class="form-actions">
                <button class="btn-primary" @onclick="SaveConfigAsync" disabled="@(!IsFormValid || _saveInFlight)">
                    @EffectiveButtonText
                </button>
            </div>

            @if (ShowCancel)
            {
                <div class="form-cancel">
                    <button class="btn-cancel-full" @onclick="Cancel">@L["setup.cancel"]</button>
                </div>

                <div class="form-disconnect">
                    @if (!_confirmingDisconnect)
                    {
                        <button class="btn-disconnect" @onclick="() => _confirmingDisconnect = true">
                            @L["setup.disconnect"]
                        </button>
                        <small class="form-hint">@L["setup.disconnectHint"]</small>
                    }
                    else
                    {
                        <p class="disconnect-warning">@L["setup.disconnectConfirm"]</p>
                        <div class="disconnect-actions">
                            <button class="btn-disconnect-confirm" @onclick="Disconnect">
                                @L["setup.disconnectYes"]
                            </button>
                            <button class="btn-cancel-full" @onclick="() => _confirmingDisconnect = false">
                                @L["setup.cancel"]
                            </button>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="setup-footer">
            <p>@L["setup.footer"]</p>
        </div>
    </div>
</div>

@code {
    [Inject]
    private SettingsStore SettingsStore { get; set; } = default!;

    [Inject]
    private Services.GitHubApiClient GitHubApi { get; set; } = default!;

    [Inject]
    private LocalizationService L { get; set; } = default!;

    [Inject]
    private Services.VaultService Vault { get; set; } = default!;

    [Parameter]
    public EventCallback ConfigSaved { get; set; }

    [Parameter]
    public EventCallback CancelClicked { get; set; }

    // Raised when the user confirms "disconnect". The wizard deliberately does NOT
    // clear anything itself: the token lives in localStorage, which only Home
    // touches, so Home owns erasing it (see Home.ClearStoredConfigAsync).
    [Parameter]
    public EventCallback DisconnectRequested { get; set; }

    [Parameter]
    public RepositoryConfig? ExistingConfig { get; set; }

    [Parameter]
    public string Title { get; set; } = "📔 GitDiary";

    // Subtitle / ButtonText default to the localized string when the caller does
    // not override them. We resolve the effective value lazily so a language
    // change re-renders correctly.
    [Parameter]
    public string? Subtitle { get; set; }

    [Parameter]
    public string? ButtonText { get; set; }

    private string EffectiveSubtitle => Subtitle
        ?? (ExistingConfig is null ? L["setup.subtitleWelcome"] : L["setup.subtitleUpdate"]);

    private string EffectiveButtonText => ButtonText
        ?? (ExistingConfig is null ? $"🚀 {L["setup.buttonStart"]}" : $"💾 {L["setup.buttonSave"]}");

    private string Owner { get; set; } = "";
    private string Repo { get; set; } = "";
    private string Branch { get; set; } = "main";
    private string Token { get; set; } = "";
    private string? ErrorMessage { get; set; }

    // Lock-password state. When no vault exists these fields set an (optional) password
    // as part of Save; when one exists they drive the change/remove actions.
    private string LockPassword { get; set; } = "";
    private string LockPasswordConfirm { get; set; } = "";
    private bool _hasVault;
    private bool _pwInFlight;
    private string? _pwMessage;
    // Minimum length for a lock password — enough to deter a casual guess without
    // being onerous. There is no server to rate-limit, so length is the main defense.
    private const int MinPasswordLength = 6;

    // Autofocus target: the first empty text input. Set by OnAfterRenderAsync
    // on the first render only so re-renders during typing don't yank focus.
    private ElementReference _ownerRef;
    private bool _autofocusApplied;
    // Prevents a rapid double-click on Save from firing two GetTree + write-test
    // round-trips (the `disabled` attribute only becomes effective after the next
    // render, which is too late during the two-second API round-trip window).
    private bool _saveInFlight;
    // Disconnect is destructive and irreversible from inside the app (the PAT is
    // write-only in the UI — it cannot be read back out to re-enter). A two-step
    // confirm keeps a misclick in the settings overlay from wiping the connection.
    // Deliberately not a JS confirm(): that would need an IJSRuntime injection here
    // purely for a modal, and this renders inline with the rest of the wizard.
    private bool _confirmingDisconnect;

    private bool ShowCancel => ExistingConfig is not null;

    private bool IsFormValid =>
        !string.IsNullOrWhiteSpace(Owner) &&
        !string.IsNullOrWhiteSpace(Repo) &&
        !string.IsNullOrWhiteSpace(Token);

    // Live-preview link to github.com/{owner}/{repo}. Appears the moment both
    // Owner and Repo have any non-whitespace content — Blazor re-renders on
    // every @oninput so the affordance shows up as the user types. We don't
    // gate on regex validation here: even a malformed URL that 404s is more
    // useful than nothing, because it lets the user see exactly what GitDiary
    // will hit and correct typos in-place.
    private string? RepoUrl
    {
        get
        {
            var owner = Owner?.Trim() ?? "";
            var repo = Repo?.Trim() ?? "";
            if (string.IsNullOrEmpty(owner) || string.IsNullOrEmpty(repo)) return null;
            return $"https://github.com/{owner}/{repo}";
        }
    }

    protected override void OnInitialized()
    {
        L.StateChanged += HandleLocalizationChanged;

        if (ExistingConfig is not null)
        {
            Owner = ExistingConfig.Owner;
            Repo = ExistingConfig.Repo;
            Branch = ExistingConfig.Branch;
            Token = ExistingConfig.Token;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        // Decide which password UI to show: "set a password" vs. "change/remove".
        // When a vault exists the app is necessarily unlocked (Home gated us), so the
        // change/remove actions have a live key to work with.
        _hasVault = await Vault.HasVaultAsync();
    }

    private void OnLockPasswordInput(ChangeEventArgs e)
    {
        LockPassword = e.Value?.ToString() ?? "";
        _pwMessage = null;
    }

    private void OnLockConfirmInput(ChangeEventArgs e)
    {
        LockPasswordConfirm = e.Value?.ToString() ?? "";
        _pwMessage = null;
    }

    private RepositoryConfig BuildConfig() => new()
    {
        Owner = Owner.Trim(),
        Repo = Repo.Trim(),
        Branch = string.IsNullOrWhiteSpace(Branch) ? "main" : Branch.Trim(),
        Token = Token.Trim()
    };

    // Validates a new password + confirmation. Returns an error message, or null if OK.
    private string? ValidateNewPassword()
    {
        if (LockPassword.Length < MinPasswordLength)
            return L.Format("setup.errorPwTooShort", MinPasswordLength);
        if (LockPassword != LockPasswordConfirm)
            return L["setup.errorPwMismatch"];
        return null;
    }

    private async Task ChangePasswordAsync()
    {
        if (_pwInFlight || string.IsNullOrEmpty(LockPassword)) return;
        var err = ValidateNewPassword();
        if (err is not null) { _pwMessage = err; return; }

        _pwInFlight = true;
        try
        {
            await Vault.ChangePasswordAsync(LockPassword, BuildConfig());
            LockPassword = "";
            LockPasswordConfirm = "";
            _pwMessage = L["setup.lockChanged"];
        }
        catch (Exception ex)
        {
            _pwMessage = L["setup.lockError"];
            Console.Error.WriteLine($"[GitDiary] SetupWizard.ChangePasswordAsync: {ex.GetType().Name}: {ex.Message}");
        }
        finally
        {
            _pwInFlight = false;
        }
    }

    private async Task RemovePasswordAsync()
    {
        if (_pwInFlight) return;
        _pwInFlight = true;
        try
        {
            await Vault.RemoveAsync(BuildConfig());
            _hasVault = false;
            LockPassword = "";
            LockPasswordConfirm = "";
            _pwMessage = L["setup.lockRemoved"];
        }
        catch (Exception ex)
        {
            _pwMessage = L["setup.lockError"];
            Console.Error.WriteLine($"[GitDiary] SetupWizard.RemovePasswordAsync: {ex.GetType().Name}: {ex.Message}");
        }
        finally
        {
            _pwInFlight = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_autofocusApplied)
        {
            _autofocusApplied = true;
            try
            {
                await _ownerRef.FocusAsync();
            }
            catch
            {
                // Ref not attached yet (unlikely on firstRender=true, but safe).
            }
        }
    }

    private async Task HandleWizardKey(KeyboardEventArgs e)
    {
        // Esc dismisses the wizard when running in settings-edit mode (i.e.,
        // when a cancel action is available). In first-run mode there is
        // nothing to cancel back to, so Esc is a no-op.
        if (e.Key == "Escape" && ShowCancel)
        {
            await Cancel();
        }
    }

    private async void HandleLocalizationChanged()
    {
        // async void: never let an exception escape to the sync context.
        try
        {
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[GitDiary] SetupWizard.HandleLocalizationChanged: {ex.GetType().Name}: {ex.Message}");
        }
    }

    private async Task OnLanguageChanged(ChangeEventArgs e)
    {
        if (e.Value is string code)
        {
            var lang = LanguageExtensions.FromCode(code);
            await L.SetLanguageAsync(lang);
        }
    }

    private void OnOwnerInput(ChangeEventArgs e)
    {
        Owner = e.Value?.ToString() ?? "";
    }

    private void OnRepoInput(ChangeEventArgs e)
    {
        Repo = e.Value?.ToString() ?? "";
    }

    private void OnBranchInput(ChangeEventArgs e)
    {
        Branch = e.Value?.ToString() ?? "";
    }

    private void OnTokenInput(ChangeEventArgs e)
    {
        Token = e.Value?.ToString() ?? "";
    }

    private async Task Cancel()
    {
        await CancelClicked.InvokeAsync();
    }

    private async Task Disconnect()
    {
        _confirmingDisconnect = false;
        await DisconnectRequested.InvokeAsync();
    }

    private async Task SaveConfigAsync()
    {
        if (_saveInFlight) return;
        _saveInFlight = true;
        try
        {
            ErrorMessage = null;

            var config = new RepositoryConfig
            {
                Owner = Owner.Trim(),
                Repo = Repo.Trim(),
                Branch = string.IsNullOrWhiteSpace(Branch) ? "main" : Branch.Trim(),
                Token = Token.Trim()
            };

            // Client-side format validation. GitHub enforces the real rules
            // server-side, but catching obvious paste errors here gives a much
            // clearer message than "HTTP 404 Not Found" from the API.
            var validationError = ValidateConfig(config);
            if (validationError is not null)
            {
                ErrorMessage = validationError;
                return;
            }

            // If the user is setting an (optional) lock password, validate it before
            // spending two API round-trips on the access tests.
            if (!_hasVault && !string.IsNullOrEmpty(LockPassword))
            {
                var pwError = ValidateNewPassword();
                if (pwError is not null)
                {
                    ErrorMessage = pwError;
                    return;
                }
            }

            try
            {
                // Configure the API client BEFORE flipping SettingsStore.IsConfigured.
                // Home listens for that flag and swaps to the app layout, which
                // synchronously mounts <Sidebar> — and Sidebar's OnInitializedAsync
                // dives straight into GitHubApiClient.GetTreeAsync. If we set
                // SettingsStore first the WASM renderer runs that mount before
                // the next two lines execute, and GetApiUrl blows up with
                // "Repository config not set".
                GitHubApi.SetConfig(config);
                GitHubApi.SetToken(config.Token);
                SettingsStore.SetConfig(config);

                // Test read access
                var testResult = await GitHubApi.GetTreeAsync();
                if (testResult.IsFailure)
                {
                    ErrorMessage = L.Format("setup.errorCannotConnect", testResult.Error ?? "");
                    return;
                }

                // Test write access
                var writeTest = await GitHubApi.TestWriteAccessAsync();
                if (writeTest.IsFailure)
                {
                    ErrorMessage = L["setup.errorNoWrite"];
                    return;
                }

                // Access verified — if a lock password was provided (and no vault
                // exists yet), encrypt the config into a vault now. This runs before
                // ConfigSaved so Home's persist step sees the vault as already active.
                if (!_hasVault && !string.IsNullOrEmpty(LockPassword))
                {
                    await Vault.CreateAsync(LockPassword, config);
                    _hasVault = true;
                    LockPassword = "";
                    LockPasswordConfirm = "";
                }

                await ConfigSaved.InvokeAsync();
            }
            catch (Exception ex)
            {
                ErrorMessage = L.Format("setup.errorConnection", ex.Message);
            }
        }
        finally
        {
            _saveInFlight = false;
        }
    }

    // GitHub username/org: 1-39 chars, alphanumeric or hyphen, no leading/trailing hyphen.
    private static readonly Regex OwnerPattern = new(
        @"^[A-Za-z0-9](?:[A-Za-z0-9]|-(?=[A-Za-z0-9])){0,38}$",
        RegexOptions.Compiled);
    // GitHub repo name: 1-100 chars, alphanumeric plus . _ -
    private static readonly Regex RepoPattern = new(
        @"^[A-Za-z0-9._-]{1,100}$",
        RegexOptions.Compiled);
    // Fine-grained PAT: "github_pat_*" (~93 chars). Classic PATs: "ghp_"+40 hex-ish.
    // Legacy hex tokens (40 hex) are also still valid on GHES. Be permissive but
    // reject obvious junk (URLs, empty spaces, whole quotes).
    private static readonly Regex TokenPattern = new(
        @"^(github_pat_[A-Za-z0-9_]{20,}|ghp_[A-Za-z0-9]{30,}|gho_[A-Za-z0-9]{30,}|ghu_[A-Za-z0-9]{30,}|ghs_[A-Za-z0-9]{30,}|[a-f0-9]{40})$",
        RegexOptions.Compiled);

    private string? ValidateConfig(RepositoryConfig cfg)
    {
        if (!OwnerPattern.IsMatch(cfg.Owner))
            return L["setup.errorInvalidOwner"];
        if (!RepoPattern.IsMatch(cfg.Repo))
            return L["setup.errorInvalidRepo"];
        if (!TokenPattern.IsMatch(cfg.Token))
            return L["setup.errorInvalidToken"];
        return null;
    }

    public void Dispose()
    {
        L.StateChanged -= HandleLocalizationChanged;
    }
}
