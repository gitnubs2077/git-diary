@using GitDiary.Client.Models
@using GitDiary.Client.Stores
@using GitDiary.Client.Services
@using System.Text.RegularExpressions
@implements IDisposable

<div class="setup-wizard" @onkeydown="HandleWizardKey">
    <div class="setup-card">
        <div class="setup-header">
            <h1 id="settings-title">📔 GitDiary</h1>
            <p class="setup-subtitle">@EffectiveSubtitle</p>
        </div>

        <div class="setup-form">
            <div class="form-group">
                <label for="language">@L["setup.language"]</label>
                <select id="language" value="@L.CurrentLanguage.Code()" @onchange="OnLanguageChanged">
                    @foreach (var lang in L.AvailableLanguages)
                    {
                        <option value="@lang.Code()">@lang.DisplayName()</option>
                    }
                </select>
            </div>

            <div class="form-group">
                <label for="owner">@L["setup.labelOwner"]</label>
                <input
                    id="owner"
                    type="text"
                    placeholder="@L["setup.placeholderOwner"]"
                    value="@Owner"
                    @oninput="OnOwnerInput"
                    @ref="_ownerRef" />
            </div>

            <div class="form-group">
                <label for="repo">@L["setup.labelRepo"]</label>
                <input
                    id="repo"
                    type="text"
                    placeholder="@L["setup.placeholderRepo"]"
                    value="@Repo"
                    @oninput="OnRepoInput" />
            </div>

            <div class="form-group">
                <label for="branch">@L["setup.labelBranch"]</label>
                <input
                    id="branch"
                    type="text"
                    placeholder="@L["setup.placeholderBranch"]"
                    value="@Branch"
                    @oninput="OnBranchInput" />
            </div>

            <div class="form-group">
                <label for="token">@L["setup.labelToken"]</label>
                <input
                    id="token"
                    type="password"
                    placeholder="@L["setup.placeholderToken"]"
                    value="@Token"
                    @oninput="OnTokenInput" />
                <small class="form-hint">
                    @L["setup.tokenHint"]
                    <a href="https://github.com/settings/tokens?type=beta" target="_blank">@L["setup.createToken"]</a>
                </small>
            </div>

            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <div class="form-error">❌ @ErrorMessage</div>
            }

            <div class="form-actions">
                <button class="btn-primary" @onclick="SaveConfigAsync" disabled="@(!IsFormValid || _saveInFlight)">
                    @EffectiveButtonText
                </button>
            </div>

            @if (ShowCancel)
            {
                <div class="form-cancel">
                    <button class="btn-cancel-full" @onclick="Cancel">@L["setup.cancel"]</button>
                </div>
            }
        </div>

        <div class="setup-footer">
            <p>@L["setup.footer"]</p>
        </div>
    </div>
</div>

@code {
    [Inject]
    private SettingsStore SettingsStore { get; set; } = default!;

    [Inject]
    private Services.GitHubApiClient GitHubApi { get; set; } = default!;

    [Inject]
    private LocalizationService L { get; set; } = default!;

    [Parameter]
    public EventCallback ConfigSaved { get; set; }

    [Parameter]
    public EventCallback CancelClicked { get; set; }

    [Parameter]
    public RepositoryConfig? ExistingConfig { get; set; }

    [Parameter]
    public string Title { get; set; } = "📔 GitDiary";

    // Subtitle / ButtonText default to the localized string when the caller does
    // not override them. We resolve the effective value lazily so a language
    // change re-renders correctly.
    [Parameter]
    public string? Subtitle { get; set; }

    [Parameter]
    public string? ButtonText { get; set; }

    private string EffectiveSubtitle => Subtitle
        ?? (ExistingConfig is null ? L["setup.subtitleWelcome"] : L["setup.subtitleUpdate"]);

    private string EffectiveButtonText => ButtonText
        ?? (ExistingConfig is null ? $"🚀 {L["setup.buttonStart"]}" : $"💾 {L["setup.buttonSave"]}");

    private string Owner { get; set; } = "";
    private string Repo { get; set; } = "";
    private string Branch { get; set; } = "main";
    private string Token { get; set; } = "";
    private string? ErrorMessage { get; set; }

    // Autofocus target: the first empty text input. Set by OnAfterRenderAsync
    // on the first render only so re-renders during typing don't yank focus.
    private ElementReference _ownerRef;
    private bool _autofocusApplied;
    // Prevents a rapid double-click on Save from firing two GetTree + write-test
    // round-trips (the `disabled` attribute only becomes effective after the next
    // render, which is too late during the two-second API round-trip window).
    private bool _saveInFlight;

    private bool ShowCancel => ExistingConfig is not null;

    private bool IsFormValid =>
        !string.IsNullOrWhiteSpace(Owner) &&
        !string.IsNullOrWhiteSpace(Repo) &&
        !string.IsNullOrWhiteSpace(Token);

    protected override void OnInitialized()
    {
        L.StateChanged += HandleLocalizationChanged;

        if (ExistingConfig is not null)
        {
            Owner = ExistingConfig.Owner;
            Repo = ExistingConfig.Repo;
            Branch = ExistingConfig.Branch;
            Token = ExistingConfig.Token;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_autofocusApplied)
        {
            _autofocusApplied = true;
            try
            {
                await _ownerRef.FocusAsync();
            }
            catch
            {
                // Ref not attached yet (unlikely on firstRender=true, but safe).
            }
        }
    }

    private async Task HandleWizardKey(KeyboardEventArgs e)
    {
        // Esc dismisses the wizard when running in settings-edit mode (i.e.,
        // when a cancel action is available). In first-run mode there is
        // nothing to cancel back to, so Esc is a no-op.
        if (e.Key == "Escape" && ShowCancel)
        {
            await Cancel();
        }
    }

    private async void HandleLocalizationChanged()
    {
        // async void: never let an exception escape to the sync context.
        try
        {
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[GitDiary] SetupWizard.HandleLocalizationChanged: {ex.GetType().Name}: {ex.Message}");
        }
    }

    private async Task OnLanguageChanged(ChangeEventArgs e)
    {
        if (e.Value is string code)
        {
            var lang = LanguageExtensions.FromCode(code);
            await L.SetLanguageAsync(lang);
        }
    }

    private void OnOwnerInput(ChangeEventArgs e)
    {
        Owner = e.Value?.ToString() ?? "";
    }

    private void OnRepoInput(ChangeEventArgs e)
    {
        Repo = e.Value?.ToString() ?? "";
    }

    private void OnBranchInput(ChangeEventArgs e)
    {
        Branch = e.Value?.ToString() ?? "";
    }

    private void OnTokenInput(ChangeEventArgs e)
    {
        Token = e.Value?.ToString() ?? "";
    }

    private async Task Cancel()
    {
        await CancelClicked.InvokeAsync();
    }

    private async Task SaveConfigAsync()
    {
        if (_saveInFlight) return;
        _saveInFlight = true;
        try
        {
            ErrorMessage = null;

            var config = new RepositoryConfig
            {
                Owner = Owner.Trim(),
                Repo = Repo.Trim(),
                Branch = string.IsNullOrWhiteSpace(Branch) ? "main" : Branch.Trim(),
                Token = Token.Trim()
            };

            // Client-side format validation. GitHub enforces the real rules
            // server-side, but catching obvious paste errors here gives a much
            // clearer message than "HTTP 404 Not Found" from the API.
            var validationError = ValidateConfig(config);
            if (validationError is not null)
            {
                ErrorMessage = validationError;
                return;
            }

            try
            {
                // Configure the API client BEFORE flipping SettingsStore.IsConfigured.
                // Home listens for that flag and swaps to the app layout, which
                // synchronously mounts <Sidebar> — and Sidebar's OnInitializedAsync
                // dives straight into GitHubApiClient.GetTreeAsync. If we set
                // SettingsStore first the WASM renderer runs that mount before
                // the next two lines execute, and GetApiUrl blows up with
                // "Repository config not set".
                GitHubApi.SetConfig(config);
                GitHubApi.SetToken(config.Token);
                SettingsStore.SetConfig(config);

                // Test read access
                var testResult = await GitHubApi.GetTreeAsync();
                if (testResult.IsFailure)
                {
                    ErrorMessage = L.Format("setup.errorCannotConnect", testResult.Error ?? "");
                    return;
                }

                // Test write access
                var writeTest = await GitHubApi.TestWriteAccessAsync();
                if (writeTest.IsFailure)
                {
                    ErrorMessage = L["setup.errorNoWrite"];
                    return;
                }

                await ConfigSaved.InvokeAsync();
            }
            catch (Exception ex)
            {
                ErrorMessage = L.Format("setup.errorConnection", ex.Message);
            }
        }
        finally
        {
            _saveInFlight = false;
        }
    }

    // GitHub username/org: 1-39 chars, alphanumeric or hyphen, no leading/trailing hyphen.
    private static readonly Regex OwnerPattern = new(
        @"^[A-Za-z0-9](?:[A-Za-z0-9]|-(?=[A-Za-z0-9])){0,38}$",
        RegexOptions.Compiled);
    // GitHub repo name: 1-100 chars, alphanumeric plus . _ -
    private static readonly Regex RepoPattern = new(
        @"^[A-Za-z0-9._-]{1,100}$",
        RegexOptions.Compiled);
    // Fine-grained PAT: "github_pat_*" (~93 chars). Classic PATs: "ghp_"+40 hex-ish.
    // Legacy hex tokens (40 hex) are also still valid on GHES. Be permissive but
    // reject obvious junk (URLs, empty spaces, whole quotes).
    private static readonly Regex TokenPattern = new(
        @"^(github_pat_[A-Za-z0-9_]{20,}|ghp_[A-Za-z0-9]{30,}|gho_[A-Za-z0-9]{30,}|ghu_[A-Za-z0-9]{30,}|ghs_[A-Za-z0-9]{30,}|[a-f0-9]{40})$",
        RegexOptions.Compiled);

    private string? ValidateConfig(RepositoryConfig cfg)
    {
        if (!OwnerPattern.IsMatch(cfg.Owner))
            return L["setup.errorInvalidOwner"];
        if (!RepoPattern.IsMatch(cfg.Repo))
            return L["setup.errorInvalidRepo"];
        if (!TokenPattern.IsMatch(cfg.Token))
            return L["setup.errorInvalidToken"];
        return null;
    }

    public void Dispose()
    {
        L.StateChanged -= HandleLocalizationChanged;
    }
}
