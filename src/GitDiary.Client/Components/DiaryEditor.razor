@using GitDiary.Client.Stores
@using GitDiary.Client.Models
@using GitDiary.Client.Infrastructure
@using GitDiary.Client.Services
@using Markdig
@using Markdig.Syntax
@using Markdig.Syntax.Inlines
@implements IDisposable

<div class="diary-editor">
    @if (DiaryStore.CurrentEntry is not null)
    {
        <div class="editor-toolbar">
            <span class="editor-date">@DiaryStore.CurrentEntry.Date.ToString("yyyy-MM-dd")</span>
            <div class="editor-actions">
                <button class="btn-save" @onclick="SaveAsync" disabled="@(!DiaryStore.IsDirty)">
                    💾 @L["editor.save"]
                </button>
                <button class="btn-commit"
                        @onclick="CommitAsync"
                        disabled="@(!CanCommit || _commitInFlight)"
                        title="@L["editor.commitTooltip"]">
                    @CommitButtonLabel
                </button>
                <div class="view-mode-toggle" role="group" aria-label="@L["editor.viewMode"]">
                    <button type="button"
                            class="view-mode-btn @(_viewMode == ViewMode.Edit ? "active" : "")"
                            @onclick="() => SetViewModeAsync(ViewMode.Edit)"
                            aria-pressed="@(_viewMode == ViewMode.Edit)">
                        ✏️ @L["editor.edit"]
                    </button>
                    <button type="button"
                            class="view-mode-btn @(_viewMode == ViewMode.Preview ? "active" : "")"
                            @onclick="() => SetViewModeAsync(ViewMode.Preview)"
                            aria-pressed="@(_viewMode == ViewMode.Preview)">
                        👁️ @L["editor.preview"]
                    </button>
                    <button type="button"
                            class="view-mode-btn @(_viewMode == ViewMode.Split ? "active" : "")"
                            @onclick="() => SetViewModeAsync(ViewMode.Split)"
                            aria-pressed="@(_viewMode == ViewMode.Split)">
                        ⬒ @L["editor.split"]
                    </button>
                </div>
                <button class="btn-delete" @onclick="ConfirmDelete">
                    🗑️ @L["editor.delete"]
                </button>
                @if (GitHubFileUrl is not null)
                {
                    <a class="btn-github-link"
                       href="@GitHubFileUrl"
                       target="_blank"
                       rel="noopener noreferrer"
                       title="@L["editor.viewOnGitHubTooltip"]">
                        🔗 @L["editor.viewOnGitHub"]
                    </a>
                }
            </div>
        </div>

        <div class="editor-content @(_viewMode == ViewMode.Split ? "split" : string.Empty)">
            @if (_viewMode != ViewMode.Preview)
            {
                <textarea
                    class="editor-textarea"
                    @bind="DiaryStore.CurrentContent"
                    @bind:event="oninput"
                    @onkeyup="HandleInput"
                    rows="20"
                    placeholder="@L["editor.placeholder"]"></textarea>
            }
            @if (_viewMode != ViewMode.Edit)
            {
                @* Contents are set via `gitdiaryPreview.setHtml` in OnAfterRenderAsync
                   — Blazor must NOT diff this element's children. Otherwise mermaid's
                   `replaceWith` (which orphans the <pre><code> nodes) causes Blazor
                   to crash on the next render with `Cannot read properties of null
                   (reading 'removeChild')`. See preview-interop.js for the rationale. *@
                <div class="editor-preview markdown-body" @ref="_previewRef"></div>
            }
        </div>
    }
    else if (DiaryStore.IsLoading)
    {
        <div class="editor-loading">@L["editor.loading"]</div>
    }
    else
    {
        <div class="editor-empty">
            <div class="empty-icon">📝</div>
            <h2>@L["editor.emptyTitle"]</h2>
            <p>@L["editor.emptyHint"]</p>
            <button class="btn-new empty-cta" @onclick="OpenTodayEntryAsync">
                @L["editor.emptyCta"]
            </button>
        </div>
    }
</div>

@if (ShowDeleteConfirm)
{
    <div class="modal-overlay" @onclick="CancelDelete">
        <div class="modal-dialog"
             role="dialog"
             aria-modal="true"
             aria-labelledby="delete-modal-title"
             @onclick:stopPropagation="true"
             @onkeydown="HandleDeleteModalKey"
             tabindex="-1"
             @ref="_deleteDialogRef">
            <div class="modal-content">
                <h3 id="delete-modal-title">@L["editor.deleteTitle"]</h3>
                <p>@L["editor.deleteConfirm"]</p>
                <p class="modal-date">@DiaryStore?.CurrentEntry?.Date.ToString("yyyy-MM-dd")</p>
                <div class="modal-actions">
                    <button class="btn-cancel" @onclick="CancelDelete">@L["editor.cancel"]</button>
                    <button class="btn-confirm-delete" @onclick="DeleteAsync" @ref="_deleteConfirmRef" disabled="@_deleteInFlight">@L["editor.confirmDelete"]</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Inject]
    private DiaryStore DiaryStore { get; set; } = default!;

    [Inject]
    private SettingsStore SettingsStore { get; set; } = default!;

    [Inject]
    private LocalizationService L { get; set; } = default!;

    [Inject]
    private ThemeService ThemeSvc { get; set; } = default!;

    [Inject]
    private IJSRuntime JS { get; set; } = default!;

    private enum ViewMode { Edit, Preview, Split }

    // Persistence key + accepted string values for the view-mode preference.
    // Values match the ThemeService/LocalizationService convention (lowercase).
    private const string ViewModeStorageKey = "gitdiary_view_mode";

    private ViewMode _viewMode = ViewMode.Edit;
    private bool ShowDeleteConfirm;
    private ElementReference _deleteDialogRef;
    private ElementReference _deleteConfirmRef;
    private ElementReference _previewRef;
    private bool _focusDeleteConfirm;
    // While the 2s debounce is armed, the user is actively typing — we pin
    // the preview to this snapshot so mermaid/Markdig don't rebuild per key.
    // Outside of a typing window, `MarkdownContent` reads DiaryStore.CurrentContent
    // directly, which sidesteps any subtlety about notification ordering during
    // entry-load transitions.
    private string _previewSnapshot = string.Empty;
    // Tracks the (source, theme) tuple that was last pushed to the preview
    // via `gitdiaryPreview.setHtml` / `gitdiaryMermaid.render`. Both are null
    // when the preview isn't mounted; a null `_lastPreviewSource` forces the
    // next mount to push HTML fresh even if the source happens to be "".
    private string? _lastPreviewSource;
    private string? _lastMermaidTheme;
    // In-flight guards. `disabled="@..."` only takes effect after Blazor re-renders,
    // and a rapid double-click can re-enter the click handler before that render
    // completes — firing two GitHub round-trips in a row. These flags short-circuit
    // the second entry synchronously.
    private bool _commitInFlight;
    private bool _deleteInFlight;

    // Debounce uses a CancellationTokenSource + Task.Delay rather than
    // System.Threading.Timer. With Timer, Dispose() cannot cancel a callback
    // that is already queued to run — so an in-flight tick and a fresh
    // keystroke could race and produce a duplicate SaveDraftAsync. Task.Delay
    // observes the token cooperatively, closing that window cleanly.
    private CancellationTokenSource? _debounceCts;

    // Preview source of truth. While a keystroke debounce is armed the user is
    // actively typing — pin the preview to `_previewSnapshot` so Markdig and
    // mermaid don't rebuild per key. In every other state (loads, saves, mode
    // switches, idle) fall through to the live buffer, which is always fresh
    // and doesn't depend on any store-notification ordering. This is what makes
    // "switch diary entry" refresh the preview reliably no matter how many
    // times it happens.
    private string PreviewSource =>
        _debounceCts is not null
            ? _previewSnapshot
            : (DiaryStore.CurrentContent ?? string.Empty);

    // Commit button is enabled whenever there's a local draft or unsaved changes,
    // and disabled while a commit is already in flight.
    private bool CanCommit =>
        DiaryStore.CurrentEntry is not null
        && DiaryStore.SyncState != SyncState.Saving
        && (DiaryStore.IsDirty || DiaryStore.HasUncommittedDraft);

    private string CommitButtonLabel => DiaryStore.SyncState switch
    {
        SyncState.Saving => $"⏫ {L["editor.committing"]}",
        SyncState.Conflict => $"⚠️ {L["editor.commitConflict"]}",
        SyncState.Failed => $"🔁 {L["editor.retryCommit"]}",
        _ => $"⏫ {L["editor.commit"]}"
    };

    // Deep link to the corresponding Markdown file on github.com. Only surfaced
    // once the entry actually exists remotely (non-empty SHA) — otherwise the
    // link would 404 for anything the user has typed locally but not committed.
    private string? GitHubFileUrl =>
        DiaryStore.CurrentEntry is { } entry && !string.IsNullOrEmpty(entry.Sha)
            ? PathHelper.GetGitHubFileUrl(SettingsStore.Config, entry.Date)
            : null;

    protected override void OnInitialized()
    {
        DiaryStore.StateChanged += HandleStoreChanged;
        L.StateChanged += HandleStoreChanged;
        ThemeSvc.StateChanged += HandleThemeChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        // Restore the persisted view-mode preference. A brief 1-frame flash from
        // the default (Edit) to the stored value is acceptable — same trade-off
        // ThemeService makes without an inline boot script.
        string? code = null;
        try
        {
            code = await JS.InvokeAsync<string?>("localStorage.getItem", ViewModeStorageKey);
        }
        catch
        {
            // localStorage unavailable — keep default.
        }

        var restored = ParseViewMode(code);
        if (restored != _viewMode)
        {
            _viewMode = restored;
            // Seed the snapshot so the preview isn't blank on first paint when
            // we come up already in Preview / Split.
            if (_viewMode != ViewMode.Edit)
            {
                _previewSnapshot = DiaryStore.CurrentContent ?? string.Empty;
            }
        }
    }

    private static ViewMode ParseViewMode(string? code) => code switch
    {
        "preview" => ViewMode.Preview,
        "split" => ViewMode.Split,
        _ => ViewMode.Edit,
    };

    private void HandleThemeChanged()
    {
        // Force the next OnAfterRenderAsync to re-run mermaid so live diagrams
        // pick up the new theme. Cheap: no-ops when preview is not visible.
        _lastMermaidTheme = null;
        _ = InvokeAsync(StateHasChanged);
    }

    private async void HandleStoreChanged()
    {
        // async void: any exception escapes to the sync context and can tear
        // down the render loop. Swallow + log so a transient render glitch
        // doesn't kill the editor.
        try
        {
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[GitDiary] DiaryEditor.HandleStoreChanged: {ex.GetType().Name}: {ex.Message}");
        }
    }

    private async Task SetViewModeAsync(ViewMode mode)
    {
        if (_viewMode == mode) return;

        // Leaving Edit: flush any pending local save so the freshly-visible
        // preview reflects the latest keystrokes. Mirrors the pre-split
        // TogglePreview behavior.
        if (_viewMode == ViewMode.Edit && DiaryStore.IsDirty)
        {
            CancelDebounce();
            await DiaryStore.SaveDraftAsync();
        }

        _viewMode = mode;

        // Entering any preview-visible mode: refresh the snapshot now so the
        // pane isn't blank / stale for the debounce window.
        if (mode != ViewMode.Edit)
        {
            _previewSnapshot = DiaryStore.CurrentContent ?? string.Empty;
        }

        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem",
                ViewModeStorageKey, mode.ToString().ToLowerInvariant());
        }
        catch
        {
            // Ignore — in-memory state still reflects the choice.
        }

        await InvokeAsync(StateHasChanged);
    }

    private void HandleInput(KeyboardEventArgs e)
    {
        // Ctrl+S → immediate local save.
        if (e.Key == "s" && e.CtrlKey)
        {
            CancelDebounce();
            _ = InvokeAsync(SaveAsync);
            return;
        }

        // Otherwise, 2s debounce that persists the draft to localStorage — never to GitHub.
        ScheduleDebouncedAutoSave();
    }

    private void ScheduleDebouncedAutoSave()
    {
        // Transitioning from "not typing" → "typing": capture the current
        // buffer as the snapshot the preview will pin to for the next 2s.
        // Without this, PreviewSource would return an empty _previewSnapshot
        // on the very first typing burst after mount and the pane would
        // flash blank between keystrokes.
        if (_debounceCts is null)
        {
            _previewSnapshot = DiaryStore.CurrentContent ?? string.Empty;
        }
        CancelDebounce();
        var cts = new CancellationTokenSource();
        _debounceCts = cts;
        _ = RunDebouncedAutoSaveAsync(cts);
    }

    private async Task RunDebouncedAutoSaveAsync(CancellationTokenSource cts)
    {
        try
        {
            await Task.Delay(2000, cts.Token);
        }
        catch (OperationCanceledException)
        {
            return;
        }
        finally
        {
            // Only null out the field if this call still owns it — a newer
            // keystroke may have already replaced _debounceCts.
            if (ReferenceEquals(_debounceCts, cts))
            {
                _debounceCts = null;
            }
            cts.Dispose();
        }

        await InvokeAsync(AutoSaveDraftAsync);
    }

    private void CancelDebounce()
    {
        var cts = _debounceCts;
        _debounceCts = null;
        if (cts is null) return;
        try
        {
            cts.Cancel();
        }
        catch (ObjectDisposedException)
        {
            // Already disposed by the debounce task's finally block — ignore.
        }
        // Disposal is handled by RunDebouncedAutoSaveAsync's finally.
    }

    private async Task AutoSaveDraftAsync()
    {
        if (DiaryStore.IsDirty && DiaryStore.CurrentEntry is not null)
        {
            await DiaryStore.SaveDraftAsync();
        }

        // Refresh the preview snapshot in step with the autosave tick. This is
        // the mechanism that gives Split its "updates every 2s after you stop
        // typing" feel without wiring a second timer.
        _previewSnapshot = DiaryStore.CurrentContent ?? string.Empty;
        StateHasChanged();
    }

    private async Task SaveAsync()
    {
        CancelDebounce();
        await DiaryStore.SaveDraftAsync();
        // Ctrl+S is an explicit "make it happen now" signal — refresh the
        // preview immediately rather than waiting for the (now-cancelled)
        // debounce tick.
        _previewSnapshot = DiaryStore.CurrentContent ?? string.Empty;
    }

    private async Task CommitAsync()
    {
        if (_commitInFlight) return;
        _commitInFlight = true;
        try
        {
            // Ensure the latest keystrokes are captured into the draft before pushing.
            CancelDebounce();
            if (DiaryStore.IsDirty)
            {
                await DiaryStore.SaveDraftAsync();
            }
            await DiaryStore.CommitCurrentEntryAsync();
        }
        finally
        {
            _commitInFlight = false;
        }
    }

    private void ConfirmDelete()
    {
        ShowDeleteConfirm = true;
        _focusDeleteConfirm = true;
    }

    private void CancelDelete()
    {
        ShowDeleteConfirm = false;
    }

    private void HandleDeleteModalKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            CancelDelete();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusDeleteConfirm && ShowDeleteConfirm)
        {
            _focusDeleteConfirm = false;
            try
            {
                // Focus lands on the destructive button — the reference actually
                // captured at render time (`_deleteConfirmRef`). Previously we
                // focused the wrapper `<div>` (`_deleteDialogRef`), which meant
                // keyboard users landed on the container and had to Tab twice to
                // reach an actionable element.
                await _deleteConfirmRef.FocusAsync();
            }
            catch
            {
                // Element not yet in DOM — safe to skip.
            }
        }

        await UpdatePreviewAsync();
    }

    private async Task UpdatePreviewAsync()
    {
        // The preview <div> only exists when both `_viewMode != Edit` AND an
        // entry is loaded (see the outer `if (CurrentEntry is not null)` in
        // markup). Without the second check, a persisted Split preference from
        // localStorage causes us to call into JS on an unmounted ref — Blazor
        // marshals a default ElementReference and JS crashes.
        if (_viewMode == ViewMode.Edit || DiaryStore.CurrentEntry is null)
        {
            // Preview isn't in the DOM; forget tracking so the next open re-pushes.
            _lastPreviewSource = null;
            _lastMermaidTheme = null;
            return;
        }

        var source = PreviewSource;
        var theme = ThemeSvc.ResolvedTheme.Code();
        var sourceChanged = _lastPreviewSource != source;
        var themeChanged = _lastMermaidTheme != theme;
        if (!sourceChanged && !themeChanged) return;

        if (sourceChanged)
        {
            // JS-managed innerHTML: mermaid's `replaceWith` mutations inside this
            // container are safe because Blazor does NOT diff the preview's
            // children (see preview-interop.js). Pushing new HTML also implicitly
            // wipes any prior mermaid SVGs — they'll be rebuilt from the fresh
            // `<pre><code>` blocks the interop finds.
            var html = RenderMarkdownHtml(source);
            try
            {
                await JS.InvokeVoidAsync("gitdiaryPreview.setHtml", _previewRef, html);
                _lastPreviewSource = source;
            }
            catch (Exception ex)
            {
                Console.Error.WriteLine($"[GitDiary] DiaryEditor.setHtml: {ex.GetType().Name}: {ex.Message}");
                return;
            }
        }

        _lastMermaidTheme = theme;
        try
        {
            await JS.InvokeVoidAsync("gitdiaryMermaid.render", _previewRef, theme);
        }
        catch (Exception ex)
        {
            // Interop failure must never break the editor. The preview HTML is
            // already visible; the mermaid blocks just stay as raw code fences.
            Console.Error.WriteLine($"[GitDiary] DiaryEditor.RenderMermaid: {ex.GetType().Name}: {ex.Message}");
        }
    }

    private async Task DeleteAsync()
    {
        if (_deleteInFlight) return;
        _deleteInFlight = true;
        try
        {
            var result = await DiaryStore.DeleteCurrentEntryAsync();
            if (result.IsFailure)
            {
                // Leave the modal open so the user can retry. SyncState is now
                // Failed, so the status bar surfaces the problem; console gets
                // the exact API error for bug reports.
                Console.Error.WriteLine($"[GitDiary] DiaryEditor.DeleteAsync failed: {result.Error}");
                return;
            }
            ShowDeleteConfirm = false;
        }
        finally
        {
            _deleteInFlight = false;
        }
    }

    // Empty-state CTA: when nothing has been selected yet, one click drops the
    // user straight into today's entry. Mirrors the "+ Today" sidebar button so
    // an out-of-focus user isn't stranded on an instructional-only screen.
    private async Task OpenTodayEntryAsync()
    {
        var today = PathHelper.GetToday();
        await DiaryStore.LoadEntryAsync(today);
    }

    private static string RenderMarkdownHtml(string content)
    {
        if (string.IsNullOrEmpty(content))
            return string.Empty;

        // Use a sanitizing pipeline that strips inline HTML and rewrites
        // javascript:/vbscript:/data: URLs. Without this the Markdown preview
        // is a stored-XSS sink that can exfiltrate the GitHub PAT from
        // localStorage. See P0-SEC-1 in the release audit.
        return Markdown.ToHtml(content, SafeMarkdownPipeline);
    }

    private static readonly MarkdownPipeline SafeMarkdownPipeline = BuildSafePipeline();

    private static readonly HashSet<string> AllowedUrlSchemes = new(StringComparer.OrdinalIgnoreCase)
    {
        "http",
        "https",
        "mailto",
        "tel"
    };

    private static MarkdownPipeline BuildSafePipeline()
    {
        var builder = new MarkdownPipelineBuilder()
            .DisableHtml()
            .UseAutoLinks()
            .UseSoftlineBreakAsHardlineBreak();
        builder.DocumentProcessed += SanitizeLinks;
        return builder.Build();
    }

    private static void SanitizeLinks(MarkdownDocument document)
    {
        foreach (var link in document.Descendants<LinkInline>())
        {
            if (!IsSafeUrl(link.Url))
            {
                link.Url = string.Empty;
            }
        }

        foreach (var link in document.Descendants<AutolinkInline>())
        {
            if (!IsSafeUrl(link.Url))
            {
                link.Url = string.Empty;
            }
        }
    }

    private static bool IsSafeUrl(string? url)
    {
        if (string.IsNullOrWhiteSpace(url))
            return true;

        var trimmed = url.TrimStart();
        if (trimmed.Length == 0)
            return true;

        // Fragment, root-relative, query-relative, and dot-relative paths are all safe.
        if (trimmed[0] is '#' or '/' or '?' or '.')
            return true;

        var colonIdx = trimmed.IndexOf(':');
        if (colonIdx <= 0)
            return true; // no scheme → treat as relative

        var scheme = trimmed[..colonIdx];
        return AllowedUrlSchemes.Contains(scheme);
    }

    public void Dispose()
    {
        DiaryStore.StateChanged -= HandleStoreChanged;
        L.StateChanged -= HandleStoreChanged;
        ThemeSvc.StateChanged -= HandleThemeChanged;
        CancelDebounce();
    }
}
