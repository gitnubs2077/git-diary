@using GitDiary.Client.Stores
@using GitDiary.Client.Models
@using GitDiary.Client.Infrastructure
@using GitDiary.Client.Services
@using Markdig
@using Markdig.Syntax
@using Markdig.Syntax.Inlines
@implements IDisposable

<div class="diary-editor">
    @if (DiaryStore.CurrentEntry is not null)
    {
        <div class="editor-toolbar">
            <span class="editor-date">@DiaryStore.CurrentEntry.Date.ToString("yyyy-MM-dd")</span>
            <div class="editor-actions">
                <button class="btn-save" @onclick="SaveAsync" disabled="@(!DiaryStore.IsDirty)">
                    💾 @L["editor.save"]
                </button>
                <button class="btn-commit"
                        @onclick="CommitAsync"
                        disabled="@(!CanCommit)"
                        title="@L["editor.commitTooltip"]">
                    @CommitButtonLabel
                </button>
                <button class="btn-preview-toggle" @onclick="TogglePreview">
                    @(ShowPreview ? $"✏️ {L["editor.edit"]}" : $"👁️ {L["editor.preview"]}")
                </button>
                <button class="btn-delete" @onclick="ConfirmDelete">
                    🗑️ @L["editor.delete"]
                </button>
            </div>
        </div>

        <div class="editor-content">
            @if (!ShowPreview)
            {
                <textarea
                    class="editor-textarea"
                    @bind="DiaryStore.CurrentContent"
                    @bind:event="oninput"
                    @onkeyup="HandleInput"
                    rows="20"
                    placeholder="@L["editor.placeholder"]"></textarea>
            }
            else
            {
                <div class="editor-preview markdown-body">
                    @MarkdownContent
                </div>
            }
        </div>
    }
    else if (DiaryStore.IsLoading)
    {
        <div class="editor-loading">@L["editor.loading"]</div>
    }
    else
    {
        <div class="editor-empty">
            <div class="empty-icon">📝</div>
            <h2>@L["editor.emptyTitle"]</h2>
            <p>@L["editor.emptyHint"]</p>
            <button class="btn-new empty-cta" @onclick="OpenTodayEntryAsync">
                @L["editor.emptyCta"]
            </button>
        </div>
    }
</div>

@if (ShowDeleteConfirm)
{
    <div class="modal-overlay" @onclick="CancelDelete">
        <div class="modal-dialog"
             role="dialog"
             aria-modal="true"
             aria-labelledby="delete-modal-title"
             @onclick:stopPropagation="true"
             @onkeydown="HandleDeleteModalKey"
             tabindex="-1"
             @ref="_deleteDialogRef">
            <div class="modal-content">
                <h3 id="delete-modal-title">@L["editor.deleteTitle"]</h3>
                <p>@L["editor.deleteConfirm"]</p>
                <p class="modal-date">@DiaryStore?.CurrentEntry?.Date.ToString("yyyy-MM-dd")</p>
                <div class="modal-actions">
                    <button class="btn-cancel" @onclick="CancelDelete">@L["editor.cancel"]</button>
                    <button class="btn-confirm-delete" @onclick="DeleteAsync" @ref="_deleteConfirmRef">@L["editor.confirmDelete"]</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Inject]
    private DiaryStore DiaryStore { get; set; } = default!;

    [Inject]
    private LocalizationService L { get; set; } = default!;

    private bool ShowPreview;
    private bool ShowDeleteConfirm;
    private ElementReference _deleteDialogRef;
    private ElementReference _deleteConfirmRef;
    private bool _focusDeleteConfirm;

    // Debounce uses a CancellationTokenSource + Task.Delay rather than
    // System.Threading.Timer. With Timer, Dispose() cannot cancel a callback
    // that is already queued to run — so an in-flight tick and a fresh
    // keystroke could race and produce a duplicate SaveDraftAsync. Task.Delay
    // observes the token cooperatively, closing that window cleanly.
    private CancellationTokenSource? _debounceCts;
    private MarkupString MarkdownContent => RenderMarkdown(DiaryStore.CurrentContent);

    // Commit button is enabled whenever there's a local draft or unsaved changes,
    // and disabled while a commit is already in flight.
    private bool CanCommit =>
        DiaryStore.CurrentEntry is not null
        && DiaryStore.SyncState != SyncState.Saving
        && (DiaryStore.IsDirty || DiaryStore.HasUncommittedDraft);

    private string CommitButtonLabel => DiaryStore.SyncState switch
    {
        SyncState.Saving => $"⏫ {L["editor.committing"]}",
        SyncState.Conflict => $"⚠️ {L["editor.commitConflict"]}",
        SyncState.Failed => $"🔁 {L["editor.retryCommit"]}",
        _ => $"⏫ {L["editor.commit"]}"
    };

    protected override void OnInitialized()
    {
        DiaryStore.StateChanged += HandleStoreChanged;
        L.StateChanged += HandleStoreChanged;
    }

    private async void HandleStoreChanged()
    {
        // async void: any exception escapes to the sync context and can tear
        // down the render loop. Swallow + log so a transient render glitch
        // doesn't kill the editor.
        try
        {
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[GitDiary] DiaryEditor.HandleStoreChanged: {ex.GetType().Name}: {ex.Message}");
        }
    }

    private async Task TogglePreview()
    {
        // Flush any pending local save before switching views so the preview is fresh.
        if (DiaryStore.IsDirty)
        {
            CancelDebounce();
            await DiaryStore.SaveDraftAsync();
        }

        ShowPreview = !ShowPreview;
        await InvokeAsync(StateHasChanged);
    }

    private void HandleInput(KeyboardEventArgs e)
    {
        // Ctrl+S → immediate local save.
        if (e.Key == "s" && e.CtrlKey)
        {
            CancelDebounce();
            _ = InvokeAsync(SaveAsync);
            return;
        }

        // Otherwise, 2s debounce that persists the draft to localStorage — never to GitHub.
        ScheduleDebouncedAutoSave();
    }

    private void ScheduleDebouncedAutoSave()
    {
        CancelDebounce();
        var cts = new CancellationTokenSource();
        _debounceCts = cts;
        _ = RunDebouncedAutoSaveAsync(cts);
    }

    private async Task RunDebouncedAutoSaveAsync(CancellationTokenSource cts)
    {
        try
        {
            await Task.Delay(2000, cts.Token);
        }
        catch (OperationCanceledException)
        {
            return;
        }
        finally
        {
            // Only null out the field if this call still owns it — a newer
            // keystroke may have already replaced _debounceCts.
            if (ReferenceEquals(_debounceCts, cts))
            {
                _debounceCts = null;
            }
            cts.Dispose();
        }

        await InvokeAsync(AutoSaveDraftAsync);
    }

    private void CancelDebounce()
    {
        var cts = _debounceCts;
        _debounceCts = null;
        if (cts is null) return;
        try
        {
            cts.Cancel();
        }
        catch (ObjectDisposedException)
        {
            // Already disposed by the debounce task's finally block — ignore.
        }
        // Disposal is handled by RunDebouncedAutoSaveAsync's finally.
    }

    private async Task AutoSaveDraftAsync()
    {
        if (DiaryStore.IsDirty && DiaryStore.CurrentEntry is not null)
        {
            await DiaryStore.SaveDraftAsync();
        }
    }

    private async Task SaveAsync()
    {
        CancelDebounce();
        await DiaryStore.SaveDraftAsync();
    }

    private async Task CommitAsync()
    {
        // Ensure the latest keystrokes are captured into the draft before pushing.
        CancelDebounce();
        if (DiaryStore.IsDirty)
        {
            await DiaryStore.SaveDraftAsync();
        }
        await DiaryStore.CommitCurrentEntryAsync();
    }

    private void ConfirmDelete()
    {
        ShowDeleteConfirm = true;
        _focusDeleteConfirm = true;
    }

    private void CancelDelete()
    {
        ShowDeleteConfirm = false;
    }

    private void HandleDeleteModalKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            CancelDelete();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusDeleteConfirm && ShowDeleteConfirm)
        {
            _focusDeleteConfirm = false;
            try
            {
                // Initial focus lands on the destructive button so keyboard users
                // see where the modal is; the modal owner's Escape key still
                // aborts. If you'd rather auto-focus the cancel button instead,
                // switch to _deleteDialogRef → Cancel.
                await _deleteDialogRef.FocusAsync();
            }
            catch
            {
                // Element not yet in DOM — safe to skip.
            }
        }
    }

    private async Task DeleteAsync()
    {
        ShowDeleteConfirm = false;
        await DiaryStore.DeleteCurrentEntryAsync();
    }

    // Empty-state CTA: when nothing has been selected yet, one click drops the
    // user straight into today's entry. Mirrors the "+ Today" sidebar button so
    // an out-of-focus user isn't stranded on an instructional-only screen.
    private async Task OpenTodayEntryAsync()
    {
        var today = PathHelper.GetToday();
        await DiaryStore.LoadEntryAsync(today);
    }

    private MarkupString RenderMarkdown(string content)
    {
        if (string.IsNullOrEmpty(content))
            return new MarkupString("");

        // Use a sanitizing pipeline that strips inline HTML and rewrites
        // javascript:/vbscript:/data: URLs. Without this the Markdown preview
        // is a stored-XSS sink that can exfiltrate the GitHub PAT from
        // localStorage. See P0-SEC-1 in the release audit.
        var html = Markdown.ToHtml(content, SafeMarkdownPipeline);
        return new MarkupString(html);
    }

    private static readonly MarkdownPipeline SafeMarkdownPipeline = BuildSafePipeline();

    private static readonly HashSet<string> AllowedUrlSchemes = new(StringComparer.OrdinalIgnoreCase)
    {
        "http",
        "https",
        "mailto",
        "tel"
    };

    private static MarkdownPipeline BuildSafePipeline()
    {
        var builder = new MarkdownPipelineBuilder()
            .DisableHtml()
            .UseAutoLinks()
            .UseSoftlineBreakAsHardlineBreak();
        builder.DocumentProcessed += SanitizeLinks;
        return builder.Build();
    }

    private static void SanitizeLinks(MarkdownDocument document)
    {
        foreach (var link in document.Descendants<LinkInline>())
        {
            if (!IsSafeUrl(link.Url))
            {
                link.Url = string.Empty;
            }
        }

        foreach (var link in document.Descendants<AutolinkInline>())
        {
            if (!IsSafeUrl(link.Url))
            {
                link.Url = string.Empty;
            }
        }
    }

    private static bool IsSafeUrl(string? url)
    {
        if (string.IsNullOrWhiteSpace(url))
            return true;

        var trimmed = url.TrimStart();
        if (trimmed.Length == 0)
            return true;

        // Fragment, root-relative, query-relative, and dot-relative paths are all safe.
        if (trimmed[0] is '#' or '/' or '?' or '.')
            return true;

        var colonIdx = trimmed.IndexOf(':');
        if (colonIdx <= 0)
            return true; // no scheme → treat as relative

        var scheme = trimmed[..colonIdx];
        return AllowedUrlSchemes.Contains(scheme);
    }

    public void Dispose()
    {
        DiaryStore.StateChanged -= HandleStoreChanged;
        L.StateChanged -= HandleStoreChanged;
        CancelDebounce();
    }
}
