@using GitDiary.Client.Stores
@using GitDiary.Client.Models
@using GitDiary.Client.Services
@implements IDisposable

<div class="status-bar">
    <div class="status-left">
        @if (DiaryStore.SyncState == SyncState.Synced)
        {
            <span class="status-synced">✅ @L["status.committed"]</span>
        }
        else if (DiaryStore.SyncState == SyncState.Saving)
        {
            <span class="status-saving">⏫ @L["status.committing"]</span>
        }
        else if (DiaryStore.SyncState == SyncState.Pending)
        {
            <span class="status-pending">📝 @L["status.pending"]</span>
        }
        else if (DiaryStore.SyncState == SyncState.Conflict)
        {
            <span class="status-conflict">⚠️ @L["status.conflict"]</span>
        }
        else if (DiaryStore.SyncState == SyncState.Failed)
        {
            <span class="status-failed">❌ @L["status.failed"]</span>
        }

        @if (DiaryStore.IsDirty)
        {
            <span class="status-message">@L["status.unsaved"]</span>
        }

        @if (!string.IsNullOrEmpty(StatusMessage))
        {
            <span class="status-message">@StatusMessage</span>
        }
    </div>
    <div class="status-right">
        @if (IsOffline)
        {
            <span class="status-offline" role="status">📶 @L["status.offline"]</span>
        }
        @if (DiaryStore.CurrentEntry is not null)
        {
            <span class="status-wordcount">@L.Format("status.words", CountWords(DiaryStore.CurrentContent))</span>
        }
        <span class="status-entries">@L.Format("status.entries", DiaryStore.Entries.Count)</span>
    </div>
</div>

@code {
    [Inject]
    private DiaryStore DiaryStore { get; set; } = default!;

    [Inject]
    private LocalizationService L { get; set; } = default!;

    [Parameter]
    public string? StatusMessage { get; set; }

    [Parameter]
    public bool IsOffline { get; set; }

    /// <summary>
    /// Rough word count for the status bar. Splits on whitespace, tolerating any
    /// stretch of runs (spaces, tabs, newlines). Not a linguistic word count for
    /// CJK — for those scripts it effectively becomes a "space-delimited run"
    /// count, which still tracks writing progress meaningfully.
    /// </summary>
    private static int CountWords(string? content)
    {
        if (string.IsNullOrWhiteSpace(content)) return 0;
        return content.Split(WhitespaceChars, StringSplitOptions.RemoveEmptyEntries).Length;
    }

    private static readonly char[] WhitespaceChars = { ' ', '\t', '\r', '\n', '\f', '\v' };

    protected override void OnInitialized()
    {
        DiaryStore.StateChanged += HandleStoreChanged;
        L.StateChanged += HandleStoreChanged;
    }

    private async void HandleStoreChanged()
    {
        // async void: never let an exception escape to the sync context.
        try
        {
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[GitDiary] StatusBar.HandleStoreChanged: {ex.GetType().Name}: {ex.Message}");
        }
    }

    public void Dispose()
    {
        DiaryStore.StateChanged -= HandleStoreChanged;
        L.StateChanged -= HandleStoreChanged;
    }
}
